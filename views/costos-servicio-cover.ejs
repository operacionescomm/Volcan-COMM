<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:1600px;height:900px;overflow:hidden}body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}.slide{position:relative;width:1600px;height:900px;padding:18px 30px 86px;background:linear-gradient(135deg,#fff 0%,#fbfdff 65%,#f1f6fd 100%);overflow:hidden}.brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:30px;color:#fff;z-index:4}.brand-lock{display:flex;align-items:center;gap:12px}.brand svg,.footer svg{stroke:#fff;fill:none}.brand svg{width:42px;height:42px;stroke-width:2.2}.brand-word{font-size:39px;font-weight:900;letter-spacing:1px}.header-line{position:absolute;left:1055px;top:34px;width:92px;height:5px;border-radius:4px;background:#f26b12}.tech{position:absolute;right:-60px;top:115px;width:760px;height:640px;opacity:.42}.tech svg{width:100%;height:100%}.hero{position:absolute;left:110px;top:240px;width:950px}.title{font-size:84px;font-weight:900;letter-spacing:1.5px;color:#061a68;line-height:.95;text-shadow:0 3px 7px rgba(6,26,104,.12)}.accent{width:145px;height:4px;background:#f26b12;border-radius:5px;margin-top:42px;margin-bottom:28px}.subtitle{font-size:37px;line-height:1.18;color:#687891;font-weight:800}.chips{display:flex;gap:38px;margin-top:42px}.chip{width:260px;height:165px;background:#fff;border:1px solid #d8e4ef;border-radius:16px;box-shadow:0 12px 23px rgba(18,71,125,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:15px}.chip-icon{width:76px;height:76px;border-radius:50%;background:#eef4fb;display:grid;place-items:center;color:#2d56a0;font-size:38px;font-weight:900}.chip-title{font-size:24px;font-weight:900;color:#061a68}.footer{position:absolute;left:25px;right:25px;bottom:16px;height:63px;background:linear-gradient(90deg,#2e56a0,#063774);display:flex;align-items:center;padding-left:32px;color:#fff;overflow:hidden}.footer svg{width:30px;height:30px;stroke-width:2}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:17px;font-size:22px;color:rgba(255,255,255,.7);font-weight:800}.footer-inner strong{color:rgba(255,255,255,.72);font-size:25px}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<div class="slide">
  <div class="brand"><div class="brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><div class="brand-word">COMM</div></div></div>
  <div class="header-line"></div>
  <div class="tech"><svg viewBox="0 0 760 640" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="g" cx="50%" cy="45%" r="65%"><stop offset="0" stop-color="#0d4a98" stop-opacity=".22"/><stop offset="1" stop-color="#0d4a98" stop-opacity="0"/></radialGradient></defs><rect width="760" height="640" fill="url(#g)"/><g stroke="#98b6df" stroke-width="1.2" opacity=".45"><path d="M80 380L220 250L360 320L520 210L690 300"/><path d="M120 500L300 410L500 520L680 410"/><path d="M220 250L230 90L520 210L560 80"/><path d="M360 320L300 410L230 90"/><path d="M520 210L500 520"/></g><g fill="#98b6df" opacity=".52"><circle cx="80" cy="380" r="9"/><circle cx="220" cy="250" r="10"/><circle cx="360" cy="320" r="8"/><circle cx="520" cy="210" r="10"/><circle cx="690" cy="300" r="9"/><circle cx="120" cy="500" r="8"/><circle cx="300" cy="410" r="10"/><circle cx="500" cy="520" r="9"/><circle cx="680" cy="410" r="8"/><circle cx="230" cy="90" r="7"/><circle cx="560" cy="80" r="8"/></g><g stroke="#b5c9e7" stroke-width="2" fill="none" opacity=".35"><path d="M380 250l70 40v80l-70 40l-70-40v-80z"/></g></svg></div>
  <section class="hero">
    <div class="title"><%= titulo %></div>
    <div class="accent"></div>
    <div class="subtitle"><%= subtitulo %><br><%= periodo %></div>
    <div class="chips"><% (chips||[]).forEach((c,i)=>{ %><div class="chip"><div class="chip-icon"><%= i===0?'$':(i===1?'⚙':'▦') %></div><div class="chip-title"><%= c %></div></div><% }) %></div>
  </section>
  <footer class="footer"><div class="footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.COMMUNICATIONS.com.pe</span></div><span class="footer-orange"></span></footer>
</div>
</body>
</html>
