<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:1600px;height:900px;overflow:hidden}body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}.slide{position:relative;width:1600px;height:900px;padding:18px 30px 86px;background:linear-gradient(135deg,#fff 0%,#fbfdff 58%,#eef5fd 100%);overflow:hidden}.brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:30px;color:#fff;z-index:5}.brand-lock{display:flex;align-items:center;gap:12px}.brand svg,.footer svg{stroke:#fff;fill:none}.brand svg{width:42px;height:42px;stroke-width:2.2}.brand-word{font-size:39px;font-weight:900;letter-spacing:1px}.header-line{position:absolute;left:1055px;top:34px;width:92px;height:5px;border-radius:4px;background:#f26b12;z-index:6}.bg-panel{position:absolute;right:0;top:86px;width:710px;height:728px;background:linear-gradient(135deg,rgba(238,246,255,.2),rgba(215,229,247,.94));clip-path:polygon(22% 0,100% 0,100% 100%,0 100%);opacity:.92}.tech{position:absolute;right:10px;top:140px;width:650px;height:570px;opacity:.58}.tech svg{width:100%;height:100%}.watermark{position:absolute;right:130px;top:230px;font-size:250px;font-weight:900;color:rgba(11,47,108,.055);letter-spacing:-8px}.hero{position:absolute;left:95px;top:210px;width:930px;z-index:3}.eyebrow{display:inline-flex;align-items:center;gap:14px;font-size:18px;font-weight:900;letter-spacing:2.5px;color:#e8752a;text-transform:uppercase;margin-bottom:20px}.eyebrow:before{content:'';width:86px;height:5px;background:#e8752a;border-radius:5px}.title{font-size:88px;font-weight:900;letter-spacing:2px;color:#061a68;line-height:.95;text-shadow:0 4px 9px rgba(6,26,104,.13)}.subtitle{margin-top:30px;font-size:35px;line-height:1.15;color:#687891;font-weight:800}.chips{display:flex;gap:30px;margin-top:50px}.chip{position:relative;width:250px;height:158px;background:rgba(255,255,255,.96);border:1px solid #d8e4ef;border-radius:18px;box-shadow:0 18px 32px rgba(18,71,125,.11);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;overflow:hidden}.chip:before{content:'';position:absolute;left:0;top:0;right:0;height:6px;background:linear-gradient(90deg,#0b4a9a,#e8752a)}.chip-icon{width:76px;height:76px;border-radius:50%;background:linear-gradient(145deg,#eef4fb,#dce9f9);display:grid;place-items:center;color:#2d56a0;font-size:38px;font-weight:900;box-shadow:inset 0 0 0 1px rgba(13,71,142,.08)}.chip-title{font-size:25px;font-weight:900;color:#061a68;letter-spacing:.4px}.footer{position:absolute;left:25px;right:25px;bottom:16px;height:63px;background:linear-gradient(90deg,#2e56a0,#063774);display:flex;align-items:center;padding-left:32px;color:#fff;overflow:hidden}.footer svg{width:30px;height:30px;stroke-width:2}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:17px;font-size:22px;color:rgba(255,255,255,.86);font-weight:700}.footer-inner strong{font-size:25px}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<div class="slide">
  <div class="brand"><div class="brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><div class="brand-word">COMM</div></div></div>
  <div class="header-line"></div>
  <div class="bg-panel"></div><div class="watermark">S/</div>
  <div class="tech"><svg viewBox="0 0 650 570" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="g" cx="50%" cy="45%" r="70%"><stop offset="0" stop-color="#0d4a98" stop-opacity=".24"/><stop offset="1" stop-color="#0d4a98" stop-opacity="0"/></radialGradient></defs><rect width="650" height="570" fill="url(#g)"/><g stroke="#98b6df" stroke-width="1.25" opacity=".58"><path d="M70 360L205 230L335 298L495 185L610 285"/><path d="M110 475L285 392L480 505L620 392"/><path d="M205 230L218 78L495 185L535 72"/><path d="M335 298L285 392L218 78"/><path d="M495 185L480 505"/><path d="M70 360L285 392L610 285"/></g><g fill="#98b6df" opacity=".64"><circle cx="70" cy="360" r="9"/><circle cx="205" cy="230" r="10"/><circle cx="335" cy="298" r="8"/><circle cx="495" cy="185" r="10"/><circle cx="610" cy="285" r="9"/><circle cx="110" cy="475" r="8"/><circle cx="285" cy="392" r="10"/><circle cx="480" cy="505" r="9"/><circle cx="620" cy="392" r="8"/><circle cx="218" cy="78" r="7"/><circle cx="535" cy="72" r="8"/></g><g stroke="#b5c9e7" stroke-width="2" fill="none" opacity=".42"><path d="M360 238l70 40v80l-70 40l-70-40v-80z"/><path d="M342 285h40v40h-40z"/></g></svg></div>
  <section class="hero">
    <div class="eyebrow">Bloque económico</div>
    <div class="title"><%= titulo %></div>
    <div class="subtitle"><%= subtitulo %><br><%= periodo %></div>
    <div class="chips"><% (chips||[]).forEach((c,i)=>{ %><div class="chip"><div class="chip-icon"><%= i===0?'S/':(i===1?'⚙':'▦') %></div><div class="chip-title"><%= c %></div></div><% }) %></div>
  </section>
  <footer class="footer"><div class="footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><span class="footer-orange"></span></footer>
</div>
</body>
</html>