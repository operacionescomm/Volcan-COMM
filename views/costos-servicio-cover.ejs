<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:1600px;height:900px;overflow:hidden}
body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}
.cost-slide{position:relative;width:1600px;height:900px;background:linear-gradient(135deg,#fff 0%,#fbfdff 60%,#edf5fd 100%);overflow:hidden}
.cost-brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:30px;color:#fff;z-index:10}
.cost-brand-lock{display:flex;align-items:center;gap:12px}.cost-brand svg,.cost-footer svg{stroke:#fff;fill:none}.cost-brand svg{width:42px;height:42px;stroke-width:2.2}.cost-brand-word{font-size:39px;font-weight:900;letter-spacing:1px}
.cost-header-line{position:absolute;left:1055px;top:34px;width:92px;height:5px;border-radius:4px;background:#f26b12;z-index:11}
.cost-bg-panel{position:absolute;right:-45px;top:86px;width:820px;height:735px;background:linear-gradient(145deg,rgba(247,251,255,.1),rgba(215,231,249,.82));clip-path:polygon(18% 0,100% 0,100% 100%,0 100%);opacity:.96}
.cost-tech{position:absolute;right:-10px;top:105px;width:760px;height:650px;opacity:.72}.cost-tech svg{width:100%;height:100%}
.cost-glow{position:absolute;right:105px;top:195px;width:470px;height:470px;border-radius:50%;background:radial-gradient(circle,rgba(45,107,179,.16),rgba(45,107,179,0) 68%)}
.cost-hero{position:absolute;left:88px;top:185px;width:940px;z-index:4}
.cost-eyebrow{display:inline-flex;align-items:center;gap:14px;font-size:18px;font-weight:900;letter-spacing:2.5px;color:#e8752a;text-transform:uppercase;margin-bottom:18px}.cost-eyebrow:before{content:'';width:86px;height:5px;background:#e8752a;border-radius:5px}
.cost-title{font-size:82px;font-weight:900;letter-spacing:1.8px;color:#061a68;line-height:.96;text-shadow:0 4px 10px rgba(6,26,104,.12)}
.cost-subtitle{margin-top:28px;font-size:31px;line-height:1.17;color:#687891;font-weight:800}
.cost-chips{display:flex;gap:28px;margin-top:42px}
.cost-chip{position:relative;width:252px;height:154px;background:rgba(255,255,255,.97);border:1px solid #d6e3ef;border-radius:18px;box-shadow:0 16px 32px rgba(18,71,125,.10);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;overflow:hidden}
.cost-chip:before{content:'';position:absolute;left:0;top:0;right:0;height:6px;background:linear-gradient(90deg,#0b4a9a,#e8752a)}
.cost-chip-icon{width:70px;height:70px;border-radius:50%;background:linear-gradient(145deg,#eef4fb,#dce9f9);display:grid;place-items:center;color:#2d56a0;font-size:35px;font-weight:900;box-shadow:inset 0 0 0 1px rgba(13,71,142,.08)}
.cost-chip-title{font-size:24px;font-weight:900;color:#061a68;letter-spacing:.35px}
.cost-footer{position:absolute;left:25px;right:25px;bottom:16px;height:63px;background:linear-gradient(90deg,#2e56a0,#063774);display:flex;align-items:center;padding-left:32px;color:#fff;overflow:hidden;z-index:20}
.cost-footer svg{width:30px;height:30px;stroke-width:2}.cost-footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:17px;font-size:22px;color:rgba(255,255,255,.86);font-weight:700;white-space:nowrap}.cost-footer-inner strong{font-size:25px}.cost-footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<div class="cost-slide">
  <div class="cost-brand"><div class="cost-brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><div class="cost-brand-word">COMM</div></div></div>
  <div class="cost-header-line"></div>
  <div class="cost-bg-panel"></div><div class="cost-glow"></div>
  <div class="cost-tech"><svg viewBox="0 0 760 650" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="polyA" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#a8c4e6" stop-opacity=".16"/><stop offset="1" stop-color="#4e84bd" stop-opacity=".36"/></linearGradient><radialGradient id="fade" cx="54%" cy="50%" r="68%"><stop offset="0" stop-color="#2a69ad" stop-opacity=".15"/><stop offset="1" stop-color="#2a69ad" stop-opacity="0"/></radialGradient></defs><rect width="760" height="650" fill="url(#fade)"/><g fill="url(#polyA)" stroke="#9ab9dc" stroke-width="1.3"><polygon points="95,420 260,240 365,330 205,500"/><polygon points="260,240 515,150 365,330"/><polygon points="365,330 630,255 520,455"/><polygon points="205,500 365,330 520,455 330,575"/><polygon points="515,150 690,315 630,255"/></g><g stroke="#8fb3dc" stroke-width="1.2" opacity=".74" fill="none"><path d="M95 420L260 240L515 150L690 315L520 455L330 575L205 500Z"/><path d="M260 240L365 330L630 255"/><path d="M205 500L365 330L515 150"/><path d="M365 330L520 455"/><path d="M120 235L260 240M120 235L95 420M120 235L320 125M320 125L515 150M630 255L710 150"/></g><g fill="#4f8bc8" opacity=".82"><circle cx="95" cy="420" r="8"/><circle cx="260" cy="240" r="9"/><circle cx="365" cy="330" r="8"/><circle cx="515" cy="150" r="9"/><circle cx="690" cy="315" r="8"/><circle cx="630" cy="255" r="8"/><circle cx="520" cy="455" r="9"/><circle cx="330" cy="575" r="8"/><circle cx="205" cy="500" r="8"/><circle cx="120" cy="235" r="6"/><circle cx="320" cy="125" r="6"/><circle cx="710" cy="150" r="6"/></g><g stroke="#b8cce5" stroke-width="2" fill="none" opacity=".6"><path d="M438 292l58 34v68l-58 34l-58-34v-68z"/><circle cx="438" cy="360" r="10"/></g></svg></div>
  <section class="cost-hero">
    <div class="cost-eyebrow">Bloque económico</div>
    <div class="cost-title"><%= titulo %></div>
    <div class="cost-subtitle"><%= subtitulo %><br><%= periodo %></div>
    <div class="cost-chips"><% (chips||[]).forEach((c,i)=>{ %><div class="cost-chip"><div class="cost-chip-icon"><%= i===0?'S/':(i===1?'⚙':'▦') %></div><div class="cost-chip-title"><%= c %></div></div><% }) %></div>
  </section>
  <footer class="cost-footer"><div class="cost-footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><span class="cost-footer-orange"></span></footer>
</div>
</body>
</html>