<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= tituloVisual || titulo %></title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:1600px;height:900px;overflow:hidden}
body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2d67}
.slide{position:relative;width:1600px;height:900px;padding:24px 52px 0;background:linear-gradient(135deg,#fff 0%,#fbfdff 72%,#f4f8fd 100%);overflow:hidden}
.brand{position:absolute;right:0;top:0;width:410px;height:94px;border-bottom-left-radius:235px 98px;background:linear-gradient(145deg,#0d478e,#073772 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:38px;color:#fff;z-index:2}
.brand-mark{display:flex;align-items:center;gap:12px}.brand-globe{width:43px;height:43px}.brand-globe svg{width:43px;height:43px;stroke:#fff;fill:none;stroke-width:1.8}.brand-word{font-size:40px;font-weight:800;letter-spacing:1px}
.header{height:78px;padding-right:420px;position:relative;z-index:3}.title{font-size:39px;font-weight:800;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:82px;height:5px;border-radius:3px;background:#f26b12;margin-top:14px}
.content{height:714px;display:grid;grid-template-columns:minmax(0,1fr) 342px;grid-template-rows:365px 335px;gap:14px 18px;margin-top:4px}
.panel{background:#fff;border:1px solid #dbe5ef;border-radius:18px;box-shadow:0 7px 17px rgba(20,64,111,.10);overflow:hidden}.chart-panel{padding:10px 16px 8px}.mainchart{grid-column:1;grid-row:1}.piepanel{grid-column:2;grid-row:1;padding:18px 18px 12px;display:flex;flex-direction:column;align-items:center}.bottom{grid-column:1 / span 2;grid-row:2;display:grid;grid-template-columns:1fr 1fr;gap:18px}.bottom .chart-panel{height:335px}
.ctitle{height:40px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:#0b2f6c;letter-spacing:.2px;text-transform:uppercase}.chart-svg{width:100%;display:block;overflow:visible}.mainchart .chart-svg{height:272px}.bottom .chart-svg{height:240px}.grid{stroke:#d3dde8;stroke-width:1;stroke-dasharray:5 5}.axis{font-size:12px;fill:#173b69;font-weight:600}.bar-label{font-size:12px;fill:#1557a5;font-weight:900;text-anchor:middle}.line-label{font-size:12px;fill:#ef6b12;font-weight:900;text-anchor:middle}.legend{height:24px;display:flex;align-items:center;justify-content:center;gap:30px;font-size:13px;font-weight:700;color:#29466f}.leg{display:flex;align-items:center;gap:7px}.legbox{width:22px;height:10px;background:#1765c1}.legline{width:30px;height:4px;border-radius:2px;background:#ef6b12;position:relative}.legline:after{content:'';position:absolute;width:8px;height:8px;border-radius:50%;background:#ef6b12;left:11px;top:-2px}
.pie-title{font-size:22px;font-weight:800;color:#0b2f6c;margin-top:2px}.pie-sub{font-size:13px;color:#758499;font-weight:700;margin-top:4px}.donut{width:220px;height:220px;border-radius:50%;margin-top:13px;background:conic-gradient(#1765c1 0 var(--inc),#ff7617 var(--inc) 100%);position:relative}.donut:after{content:'';position:absolute;inset:54px;background:#fff;border-radius:50%}.dcenter{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#0b2f6c}.dtotal{font-size:36px;font-weight:800;line-height:1}.dcaption{font-size:12px;font-weight:800;text-align:center;line-height:1.05;margin-top:5px}.pct{position:absolute;z-index:4;min-width:58px;padding:5px 10px;border-radius:999px;background:#fff;font-size:17px;font-weight:900;text-align:center;box-shadow:0 3px 9px rgba(10,45,95,.18)}.pct-inc{right:4px;top:43px;color:#e9610c;border:3px solid #ff7617}.pct-req{left:7px;bottom:36px;color:#1555ad;border:3px solid #1765c1}.pie-legend{width:100%;margin-top:12px;padding-top:10px;border-top:1px solid #dfe7ef;display:flex;justify-content:center;gap:18px;font-size:13px;font-weight:800}.pitem{display:flex;align-items:center;gap:6px}.pitem.inc{color:#e9610c}.pitem.req{color:#1555ad}.pdot{width:13px;height:13px}.pdot.orange{background:#ff7617}.pdot.blue{background:#1765c1}.pie-total{margin-top:10px;font-size:14px;color:#405975}.pie-total strong{font-size:18px;color:#0b2f6c}
.footer{position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);color:#fff;display:flex;align-items:center;padding-left:50px;overflow:hidden}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:15px;font-size:22px;letter-spacing:.2px}.footer-inner strong{font-size:25px;letter-spacing:.5px}.footer-globe{width:34px;height:34px}.footer-globe svg{width:34px;height:34px;stroke:#fff;fill:none;stroke-width:2}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#ff6f12;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
const fallbackSoporte = [
  ['ago-25',48,114,162], ['sept-25',55,98,153], ['oct-25',48,108,156], ['nov-25',54,107,161],
  ['dic-25',58,133,191], ['ene-26',55,82,137], ['abr-26',45,109,154], ['may-26',47,119,166],
  ['jun-26',77,155,232], ['jul-26',82,173,255]
];
const fallbackAutomatizacion = [
  ['ago-25',13,81,94], ['sept-25',8,78,86], ['oct-25',9,77,86], ['nov-25',6,71,77],
  ['dic-25',2,70,72], ['ene-26',1,68,69], ['abr-26',9,74,83], ['may-26',7,92,99],
  ['jun-26',6,91,97], ['jul-26',7,77,84]
];
function cleanSeries(raw){
  return (Array.isArray(raw) ? raw : []).map(item => {
    if(Array.isArray(item)){
      const incidentes=Number(item[1]||0), requerimientos=Number(item[2]||0);
      return {mes:String(item[0]||''),incidentes,requerimientos,total:Number(item[3]||0)||incidentes+requerimientos};
    }
    const incidentes=Number(item?.incidentes ?? item?.incidente ?? 0), requerimientos=Number(item?.requerimientos ?? item?.requerimiento ?? 0);
    return {mes:String(item?.mes||item?.periodo||''),incidentes,requerimientos,total:Number(item?.total||0)||incidentes+requerimientos};
  }).filter(d=>d.mes);
}
const general = cleanSeries(series || []);
const soporteInput = (typeof seriesSoporte !== 'undefined' && Array.isArray(seriesSoporte) && seriesSoporte.length) ? seriesSoporte : fallbackSoporte;
const autoInput = (typeof seriesAutomatizacion !== 'undefined' && Array.isArray(seriesAutomatizacion) && seriesAutomatizacion.length) ? seriesAutomatizacion : fallbackAutomatizacion;
const soporte = cleanSeries(soporteInput);
const automatizacion = cleanSeries(autoInput);
function niceMax(data){
  const max=Math.max(0,...data.flatMap(d=>[d.incidentes,d.requerimientos]));
  const step=max<=120?20:50;
  return Math.max(step*5,Math.ceil(max/step)*step);
}
function labelWidth(value,pad=14){return Math.max(26,String(value).length*7+pad)}
function chartSvg(data, opts={}){
  const w=opts.w||1050,h=opts.h||260,ml=52,mr=30,mt=18,mb=42,pw=w-ml-mr,ph=h-mt-mb;
  const ymax=niceMax(data), tick=ymax<=120?20:50;
  const sx=i=>ml+(data.length<=1?pw/2:i*pw/(data.length-1));
  const sy=v=>mt+ph-(Number(v||0)/ymax)*ph;
  const barW=opts.barW||30;
  const reqPts=data.map((d,i)=>`${sx(i)},${sy(d.requerimientos)}`).join(' ');
%>
<svg class="chart-svg" viewBox="0 0 <%= w %> <%= h %>">
  <% for(let t=0;t<=ymax;t+=tick){const y=sy(t);%><line class="grid" x1="<%= ml %>" y1="<%= y %>" x2="<%= w-mr %>" y2="<%= y %>"/><text class="axis" x="<%= ml-10 %>" y="<%= y+4 %>" text-anchor="end"><%= t %></text><%}%>
  <% data.forEach((d,i)=>{const x=sx(i)-barW/2,y=sy(d.incidentes),bw=labelWidth(d.incidentes,10),labelY=Math.max(mt+13,y-8);%>
    <rect x="<%= x %>" y="<%= y %>" width="<%= barW %>" height="<%= mt+ph-y %>" rx="1" fill="#1765c1"/>
    <rect x="<%= sx(i)-bw/2 %>" y="<%= labelY-13 %>" width="<%= bw %>" height="18" rx="9" fill="#fff" stroke="#9abce0" stroke-width="1"/>
    <text class="bar-label" x="<%= sx(i) %>" y="<%= labelY %>"><%= d.incidentes %></text>
    <text class="axis" x="<%= sx(i) %>" y="<%= h-16 %>" text-anchor="middle"><%= d.mes %></text>
  <%})%>
  <polyline points="<%= reqPts %>" fill="none" stroke="#ef6b12" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
  <% data.forEach((d,i)=>{const px=sx(i),py=sy(d.requerimientos),bw=labelWidth(d.requerimientos,14); const placeBelow=(py-32)<mt; const labelY=placeBelow?py+23:py-12; const boxY=labelY-14;%>
    <circle cx="<%= px %>" cy="<%= py %>" r="5" fill="#ef6b12" stroke="#fff" stroke-width="2"/>
    <rect x="<%= Math.max(2,Math.min(w-bw-2,px-bw/2)) %>" y="<%= boxY %>" width="<%= bw %>" height="19" rx="9.5" fill="#fff" stroke="#ef6b12" stroke-width="1.3"/>
    <text class="line-label" x="<%= px %>" y="<%= labelY %>"><%= d.requerimientos %></text>
  <%})%>
</svg>
<%}
const last=general[general.length-1]||{};
const incNow=Number(incidentesMes ?? last.incidentes ?? 0), reqNow=Number(requerimientosMes ?? last.requerimientos ?? 0), totalNow=Number(totalMes ?? last.total ?? 0)||incNow+reqNow;
const pctInc=totalNow?incNow/totalNow*100:0, pctReq=totalNow?reqNow/totalNow*100:0;
%>
<div class="slide">
  <div class="brand"><div class="brand-mark"><span class="brand-globe"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg></span><span class="brand-word">COMM</span></div></div>
  <header class="header"><div class="title"><%= tituloVisual || titulo %></div><div class="underline"></div></header>
  <main class="content">
    <section class="panel chart-panel mainchart">
      <div class="ctitle">CHUNGAR</div>
      <% chartSvg(general,{w:1090,h:270,barW:31}); %>
      <div class="legend"><span class="leg"><i class="legbox"></i>Incidente</span><span class="leg"><i class="legline"></i>Requerimiento</span></div>
    </section>
    <aside class="panel piepanel">
      <div class="pie-title"><%= mesCorto || 'Julio' %></div><div class="pie-sub">Composición de atenciones</div>
      <div class="donut" style="--inc:<%= pctInc.toFixed(2) %>%"><div class="dcenter"><div class="dtotal"><%= totalNow.toLocaleString('en-US') %></div><div class="dcaption">TOTAL<br>ATENCIONES</div></div><span class="pct pct-inc"><%= pctInc.toFixed(0) %>%</span><span class="pct pct-req"><%= pctReq.toFixed(0) %>%</span></div>
      <div class="pie-legend"><span class="pitem inc"><i class="pdot orange"></i><%= incNow.toLocaleString('en-US') %> Inc.</span><span class="pitem req"><i class="pdot blue"></i><%= reqNow.toLocaleString('en-US') %> Req.</span></div>
      <div class="pie-total">Total: <strong><%= totalNow.toLocaleString('en-US') %></strong></div>
    </aside>
    <section class="bottom">
      <section class="panel chart-panel"><div class="ctitle">SOPORTE CHUNGAR</div><% chartSvg(soporte,{w:720,h:240,barW:25}); %><div class="legend"><span class="leg"><i class="legbox"></i>Incidente</span><span class="leg"><i class="legline"></i>Requerimiento</span></div></section>
      <section class="panel chart-panel"><div class="ctitle">AUTOMATIZACIÓN CHUNGAR</div><% chartSvg(automatizacion,{w:720,h:240,barW:25}); %><div class="legend"><span class="leg"><i class="legbox"></i>Incidente</span><span class="leg"><i class="legline"></i>Requerimiento</span></div></section>
    </section>
  </main>
  <footer class="footer classic-footer"><div class="footer-inner"><span class="footer-globe"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg></span><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><span class="footer-orange"></span></footer>
</div>
</body>
</html>
