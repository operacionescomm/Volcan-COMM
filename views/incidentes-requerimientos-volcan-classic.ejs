<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:1600px;height:900px;overflow:hidden}
body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2d67}
.slide{position:relative;width:1600px;height:900px;padding:24px 28px 0;background:linear-gradient(135deg,#fff 0%,#fbfdff 72%,#f4f8fd 100%);overflow:hidden}
.brand{position:absolute;right:0;top:0;width:410px;height:94px;border-bottom-left-radius:235px 98px;background:linear-gradient(145deg,#0d478e,#073772 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:38px;color:#fff;z-index:2}.brand-mark{display:flex;align-items:center;gap:12px}.brand-globe{width:43px;height:43px}.brand-globe svg{width:43px;height:43px;stroke:#fff;fill:none;stroke-width:1.8}.brand-word{font-size:40px;font-weight:800;letter-spacing:1px}
.header{height:78px;padding-right:420px;position:relative;z-index:3}.title{font-size:39px;font-weight:800;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:82px;height:5px;border-radius:3px;background:#f26b12;margin-top:14px}
.kpis{height:126px;display:grid;grid-template-columns:1.02fr 1fr 1.08fr 1fr 1.08fr;gap:16px;margin-top:12px}.kpi{height:118px;background:#fff;border:1px solid #dbe5ef;border-radius:17px;box-shadow:0 7px 17px rgba(20,64,111,.11);display:grid;grid-template-columns:72px 1fr;align-items:center;padding:10px 14px;overflow:hidden}.kicon{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,var(--c1),var(--c2));box-shadow:0 5px 12px rgba(17,62,118,.18)}.kicon svg{width:36px;height:36px;fill:none;stroke:#fff;stroke-width:2.3;stroke-linecap:round;stroke-linejoin:round}.kcontent{padding-left:7px;min-width:0}.kname{font-size:14px;font-weight:800;line-height:1.08;color:var(--tc);text-transform:uppercase}.kvalue{font-size:41px;line-height:1;font-weight:800;color:var(--tc);margin-top:7px}.ksub{font-size:12px;color:#536579;margin-top:4px}
.main{height:488px;display:grid;grid-template-columns:1.64fr .86fr .95fr;gap:14px;margin-top:8px}.panel{background:#fff;border:1px solid #dbe5ef;border-radius:18px;box-shadow:0 7px 17px rgba(20,64,111,.10);overflow:hidden}.trend{padding:14px 16px 10px}.panel-title{font-size:20px;font-weight:800;color:#0b2f6c;text-align:center;height:42px;display:flex;align-items:center;justify-content:center}.chart-svg{width:100%;height:362px;display:block}.grid{stroke:#d3dde8;stroke-width:1;stroke-dasharray:5 5}.axis{font-size:12px;fill:#173b69;font-weight:600}.value-inc{font-size:12px;fill:#fff;font-weight:900;text-anchor:middle;dominant-baseline:middle}.value-req{font-size:12px;fill:#ef6b12;font-weight:800;text-anchor:middle;paint-order:stroke;stroke:#fff;stroke-width:4px}.legend{display:flex;justify-content:center;gap:34px;margin-top:-2px;font-size:14px;font-weight:700;color:#29466f}.leg{display:flex;align-items:center;gap:7px}.legbox{width:22px;height:10px;background:#1765c1}.legline{width:30px;height:4px;border-radius:2px;background:#ef6b12;position:relative}.legline:after{content:'';position:absolute;width:8px;height:8px;border-radius:50%;background:#ef6b12;left:11px;top:-2px}
.table-panel{padding:14px 12px}.data-table{width:100%;border-collapse:collapse;font-size:14px;color:#0e234a}.data-table th{background:linear-gradient(90deg,#0a3f87,#1559b0);color:#fff;font-size:13px;font-weight:900;padding:8px 6px;border:1px solid #d7e3ef}.data-table td{padding:6px 7px;border-bottom:1px solid #dfe8f2;text-align:right;font-weight:700}.data-table td:first-child{text-align:left;font-weight:600}.data-table tr:nth-child(even) td{background:#fbfdff}.data-table tfoot td{background:#eaf2ff!important;color:#0b2f6c;font-weight:900;border-top:2px solid #719dea}.table-title{height:28px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#0b2f6c;margin-bottom:5px;text-transform:uppercase}
.side{padding:14px 18px 12px;display:flex;flex-direction:column;align-items:center}.side-title{font-size:22px;font-weight:800;color:#0b2f6c;margin-top:2px;text-transform:uppercase}.side-sub{font-size:13px;color:#758499;font-weight:700;margin-top:4px}.donut{width:216px;height:216px;border-radius:50%;margin-top:12px;background:conic-gradient(#1765c1 0 var(--inc),#ff7617 var(--inc) 100%);position:relative}.donut:after{content:'';position:absolute;inset:54px;background:#fff;border-radius:50%}.dcenter{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#0b2f6c}.dtotal{font-size:33px;font-weight:800;line-height:1}.dcaption{font-size:12px;font-weight:800;text-align:center;line-height:1.05;margin-top:5px}.pct{position:absolute;z-index:4;min-width:58px;padding:5px 10px;border-radius:999px;background:#fff;font-size:18px;font-weight:900;text-align:center;box-shadow:0 3px 9px rgba(10,45,95,.18)}.pct-inc{right:5px;top:48px;color:#1555ad;border:3px solid #1765c1}.pct-req{left:8px;bottom:38px;color:#e9610c;border:3px solid #ff7617}.side-legend{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px;padding-top:10px;border-top:1px solid #dfe7ef;text-align:center}.sval{font-size:21px;font-weight:800}.sval.blue{color:#1765c1}.sval.orange{color:#ef6b12}.slab{font-size:13px;color:#536579;margin-top:3px}.side-lines{width:100%;margin-top:8px}.side-line{height:51px;display:grid;grid-template-columns:42px 1fr;align-items:center;border-top:1px solid #e1e8f0}.mini{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:18px}.mini.blue{background:#1765c1}.mini.orange{background:#ff7617}.stext{font-size:15px;color:#183d70}.stext strong{font-size:17px}.stext .blue{color:#1557a5}.stext .orange{color:#ef650e}
.summary{height:93px;margin-top:12px;background:#fff;border:1px solid #d7e3ef;border-radius:17px;box-shadow:0 6px 14px rgba(18,69,124,.09);display:grid;grid-template-columns:330px 1fr;align-items:center;padding:9px 24px}.sum-left{height:66px;display:flex;align-items:center;gap:18px;border-right:2px solid #6da0df;padding-right:22px}.sum-icon{width:62px;height:62px;border-radius:50%;background:linear-gradient(145deg,#247ed6,#124ca6);display:flex;align-items:center;justify-content:center}.sum-icon svg{width:36px;height:36px;stroke:#fff;fill:none;stroke-width:2.1}.sum-label{font-size:21px;font-weight:800;color:#0b2f6c;line-height:1.08}.sum-lines{padding-left:30px;display:grid;gap:8px;font-size:16px;color:#173b77}.sum-line{display:flex;align-items:center;gap:10px}.check{width:22px;height:22px;border-radius:50%;background:#1556b6;color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;flex:0 0 auto}
.footer{position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);color:#fff;display:flex;align-items:center;padding-left:50px;overflow:hidden}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:15px;font-size:22px;letter-spacing:.2px}.footer-inner strong{font-size:25px;letter-spacing:.5px}.footer-globe{width:34px;height:34px}.footer-globe svg{width:34px;height:34px;stroke:#fff;fill:none;stroke-width:2}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#ff6f12;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
const months = (Array.isArray(series) ? series : []).map(d => ({
  mes: String(d.mes || d.periodo || ''),
  incidentes: Number(d.incidentes || 0),
  requerimientos: Number(d.requerimientos || 0),
  total: Number(d.total || 0) || Number(d.incidentes || 0) + Number(d.requerimientos || 0)
}));
const sumInc = months.reduce((a,d)=>a+d.incidentes,0);
const sumReq = months.reduce((a,d)=>a+d.requerimientos,0);
const sumTotal = months.reduce((a,d)=>a+d.total,0) || Number(acumuladoTotal || 0);
const maxVal = Math.max(200, Math.ceil(Math.max(...months.flatMap(d=>[d.incidentes,d.requerimientos]), Number(typeof maxSerie !== 'undefined' ? maxSerie : 0), 1)/200)*200);
%>
<div class="slide">
  <div class="brand"><div class="brand-mark"><span class="brand-globe"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg></span><span class="brand-word">COMM</span></div></div>
  <header class="header"><div class="title">Incidentes vs Requerimientos VOLCAN</div><div class="underline"></div></header>
  <section class="kpis">
    <div class="kpi" style="--c1:#1b61b9;--c2:#0a438e;--tc:#1554a1"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M14 8h20v32H14z"/><path d="M19 5h10v7H19zM19 18h10M19 24h10M19 30h7"/></svg></div><div class="kcontent"><div class="kname">TOTAL <%= mesCorto %></div><div class="kvalue"><%= totalMes.toLocaleString('en-US') %></div></div></div>
    <div class="kpi" style="--c1:#2b80dc;--c2:#1554b5;--tc:#1554a9"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M24 5 39 11v11c0 10-6 17-15 21C15 39 9 32 9 22V11l15-6Z"/><path d="M24 15v10M24 31h.01"/></svg></div><div class="kcontent"><div class="kname">INCIDENTES (<%= mesCorto %>)</div><div class="kvalue"><%= incidentesMes.toLocaleString('en-US') %></div></div></div>
    <div class="kpi" style="--c1:#ff8629;--c2:#f05c0c;--tc:#ef650e"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M14 8h20v32H14z"/><path d="M19 5h10v7H19zM19 18h10M19 24h10M19 30h7"/></svg></div><div class="kcontent"><div class="kname">REQUERIMIENTOS (<%= mesCorto %>)</div><div class="kvalue"><%= requerimientosMes.toLocaleString('en-US') %></div></div></div>
    <div class="kpi" style="--c1:#56a7e8;--c2:#2677c7;--tc:#1a63b0"><div class="kicon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"/><path d="M24 7v17h17"/></svg></div><div class="kcontent"><div class="kname">% INCIDENTES</div><div class="kvalue"><%= pctIncidentesAcum.toFixed(0) %>%</div><div class="ksub">acumulado 12 meses</div></div></div>
    <div class="kpi" style="--c1:#ff942e;--c2:#f2670c;--tc:#ef680c"><div class="kicon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"/><path d="M24 7v17l13 10"/></svg></div><div class="kcontent"><div class="kname">% REQUERIMIENTOS</div><div class="kvalue"><%= pctRequerimientosAcum.toFixed(0) %>%</div><div class="ksub">acumulado 12 meses</div></div></div>
  </section>
  <section class="main">
    <div class="panel trend"><div class="panel-title">VOLCAN</div>
      <% const w=780,h=362,ml=58,mr=28,mt=26,mb=50,pw=w-ml-mr,ph=h-mt-mb; const sx=i=>ml+(months.length<=1?pw/2:i*pw/(months.length-1)); const sy=v=>mt+ph-(Number(v||0)/maxVal)*ph; const barW=24; const reqPts=months.map((d,i)=>`${sx(i)},${sy(d.requerimientos)}`).join(' '); %>
      <svg class="chart-svg" viewBox="0 0 780 362">
        <% for(let t=0;t<=maxVal;t+=200){const y=sy(t); %><line class="grid" x1="<%= ml %>" y1="<%= y %>" x2="<%= w-mr %>" y2="<%= y %>"/><text class="axis" x="<%= ml-12 %>" y="<%= y+4 %>" text-anchor="end"><%= t %></text><% } %>
        <% months.forEach((d,i)=>{ const x=sx(i)-barW/2; const y=sy(d.incidentes); const hh=mt+ph-y; %><rect x="<%= x %>" y="<%= y %>" width="<%= barW %>" height="<%= hh %>" fill="#1765c1"/><text class="value-inc" x="<%= sx(i) %>" y="<%= y + Math.max(14, hh*0.5) %>"><%= d.incidentes %></text><text class="axis" x="<%= sx(i) %>" y="<%= h-18 %>" text-anchor="middle"><%= d.mes %></text><% }) %>
        <polyline points="<%= reqPts %>" fill="none" stroke="#ef6b12" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"/>
        <% months.forEach((d,i)=>{ %><circle cx="<%= sx(i) %>" cy="<%= sy(d.requerimientos) %>" r="5.5" fill="#ef6b12"/><text class="value-req" x="<%= sx(i) %>" y="<%= Math.max(mt+13,sy(d.requerimientos)-11) %>"><%= d.requerimientos %></text><% }) %>
        <text class="axis" x="17" y="180" transform="rotate(-90 17 180)" text-anchor="middle" style="font-size:14px;font-weight:800">ATENCIONES</text>
      </svg><div class="legend"><div class="leg"><span class="legbox"></span>Incidente</div><div class="leg"><span class="legline"></span>Requerimiento</div></div>
    </div>
    <div class="panel table-panel"><div class="table-title">Detalle mensual</div><table class="data-table"><thead><tr><th>Mes</th><th>Incidente</th><th>Requerimiento</th><th>Total</th></tr></thead><tbody><% months.forEach(d=>{ %><tr><td><%= d.mes %></td><td><%= d.incidentes.toLocaleString('en-US') %></td><td><%= d.requerimientos.toLocaleString('en-US') %></td><td><%= d.total.toLocaleString('en-US') %></td></tr><% }) %></tbody><tfoot><tr><td>Total general</td><td><%= sumInc.toLocaleString('en-US') %></td><td><%= sumReq.toLocaleString('en-US') %></td><td><%= sumTotal.toLocaleString('en-US') %></td></tr></tfoot></table></div>
    <div class="panel side"><div class="side-title">ACUMULADO 12 MESES</div><div class="side-sub"><%= rangoPeriodo %></div><div class="donut" style="--inc:<%= pctIncidentesAcum.toFixed(2) %>%"><div class="dcenter"><div class="dtotal"><%= acumuladoTotal.toLocaleString('en-US') %></div><div class="dcaption">ATENCIONES<br>ACUMULADAS</div></div><span class="pct pct-inc"><%= pctIncidentesAcum.toFixed(0) %>%</span><span class="pct pct-req"><%= pctRequerimientosAcum.toFixed(0) %>%</span></div><div class="side-legend"><div><div class="sval blue"><%= sumInc.toLocaleString('en-US') %></div><div class="slab">Incidentes</div></div><div><div class="sval orange"><%= sumReq.toLocaleString('en-US') %></div><div class="slab">Requerimientos</div></div></div><div class="side-lines"><div class="side-line"><div class="mini blue">!</div><div class="stext"><strong><span class="blue">INCIDENTES:</span></strong> <b><%= sumInc.toLocaleString('en-US') %></b></div></div><div class="side-line"><div class="mini orange">✓</div><div class="stext"><strong><span class="orange">REQUERIMIENTOS:</span></strong> <b><%= sumReq.toLocaleString('en-US') %></b></div></div></div></div>
  </section>
  <section class="summary"><div class="sum-left"><div class="sum-icon"><svg viewBox="0 0 48 48"><path d="M9 38h30M13 34V22M22 34V15M31 34V19M12 22l10-8 8 5 8-11"/></svg></div><div class="sum-label">RESUMEN<br>EJECUTIVO</div></div><div class="sum-lines"><div class="sum-line"><span class="check">✓</span>En <%= mesCorto %> 2026, VOLCAN registró <%= totalMes.toLocaleString('en-US') %> atenciones: <%= incidentesMes.toLocaleString('en-US') %> incidentes y <%= requerimientosMes.toLocaleString('en-US') %> requerimientos.</div><div class="sum-line"><span class="check">✓</span>En el acumulado de 12 meses se registran <%= acumuladoTotal.toLocaleString('en-US') %> atenciones; los requerimientos representan <%= pctRequerimientosAcum.toFixed(0) %>% y los incidentes <%= pctIncidentesAcum.toFixed(0) %>%.</div></div></section>
  <footer class="footer"><div class="footer-inner"><span class="footer-globe"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg></span><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><span class="footer-orange"></span></footer>
</div>
</body>
</html>