<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= typeof titulo !== 'undefined' ? titulo : 'Incidentes vs Requerimientos VOLCAN' %></title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:1600px;height:900px;overflow:hidden}
body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2d67}
.slide{position:relative;width:1600px;height:900px;padding:24px 28px 0;background:linear-gradient(135deg,#fff 0%,#fbfdff 72%,#f4f8fd 100%);overflow:hidden}
.brand{position:absolute;right:0;top:0;width:410px;height:94px;border-bottom-left-radius:235px 98px;background:linear-gradient(145deg,#0d478e,#073772 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:38px;color:#fff;z-index:2}.brand-mark{display:flex;align-items:center;gap:12px}.brand-globe{width:43px;height:43px}.brand-globe svg{width:43px;height:43px;stroke:#fff;fill:none;stroke-width:1.8}.brand-word{font-size:40px;font-weight:800;letter-spacing:1px}
.header{height:78px;padding-right:420px;position:relative;z-index:3}.title{font-size:39px;font-weight:800;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:82px;height:5px;border-radius:3px;background:#f26b12;margin-top:14px}
.kpis{height:108px;display:grid;grid-template-columns:1.02fr 1fr 1.08fr 1fr 1.08fr;gap:16px;margin-top:8px}.kpi{height:102px;background:#fff;border:1px solid #dbe5ef;border-radius:16px;box-shadow:0 7px 16px rgba(20,64,111,.10);display:grid;grid-template-columns:66px 1fr;align-items:center;padding:8px 13px;overflow:hidden}.kicon{width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,var(--c1),var(--c2));box-shadow:0 5px 12px rgba(17,62,118,.18)}.kicon svg{width:32px;height:32px;fill:none;stroke:#fff;stroke-width:2.3;stroke-linecap:round;stroke-linejoin:round}.kcontent{padding-left:7px;min-width:0}.kname{font-size:13.5px;font-weight:800;line-height:1.06;color:var(--tc);text-transform:uppercase}.kvalue{font-size:38px;line-height:1;font-weight:800;color:var(--tc);margin-top:6px}.ksub{font-size:11px;color:#536579;margin-top:3px}
.main{height:478px;display:grid;grid-template-columns:1.66fr .88fr .96fr;gap:14px;margin-top:8px}.panel{background:#fff;border:1px solid #dbe5ef;border-radius:18px;box-shadow:0 7px 17px rgba(20,64,111,.10);overflow:hidden}.trend{padding:12px 16px 8px}.panel-title{font-size:20px;font-weight:800;color:#0b2f6c;text-align:center;height:36px;display:flex;align-items:center;justify-content:center}.chart-svg{width:100%;height:345px;display:block}.grid{stroke:#d3dde8;stroke-width:1;stroke-dasharray:5 5}.axis{font-size:12px;fill:#173b69;font-weight:600}.value-inc{font-size:12px;fill:#fff;font-weight:900;text-anchor:middle;dominant-baseline:middle}.value-req{font-size:12px;fill:#ef6b12;font-weight:800;text-anchor:middle;paint-order:stroke;stroke:#fff;stroke-width:4px}.legend{display:flex;justify-content:center;gap:34px;margin-top:-1px;font-size:14px;font-weight:700;color:#29466f}.leg{display:flex;align-items:center;gap:7px}.legbox{width:22px;height:10px;background:#1765c1}.legline{width:30px;height:4px;border-radius:2px;background:#ef6b12;position:relative}.legline:after{content:'';position:absolute;width:8px;height:8px;border-radius:50%;background:#ef6b12;left:11px;top:-2px}
.table-panel{padding:12px 12px}.table-title{height:26px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#0b2f6c;margin-bottom:4px;text-transform:uppercase}.data-table{width:100%;border-collapse:collapse;font-size:13.3px;color:#0e234a}.data-table th{background:linear-gradient(90deg,#0a3f87,#1559b0);color:#fff;font-size:12.5px;font-weight:900;padding:7px 5px;border:1px solid #d7e3ef}.data-table td{padding:5.7px 7px;border-bottom:1px solid #dfe8f2;text-align:right;font-weight:700}.data-table td:first-child{text-align:left;font-weight:700}.data-table tr:nth-child(even) td{background:#fbfdff}.data-table tfoot td{background:#eaf2ff!important;color:#0b2f6c;font-weight:900;border-top:2px solid #719dea}
.side{padding:13px 17px 10px;display:flex;flex-direction:column;align-items:center;overflow:hidden}.side-title{font-size:22px;font-weight:800;color:#0b2f6c;margin-top:0;text-transform:uppercase}.side-sub{font-size:12.5px;color:#758499;font-weight:700;margin-top:4px}.donut{width:204px;height:204px;border-radius:50%;margin-top:10px;background:conic-gradient(#1765c1 0 var(--inc),#ff7617 var(--inc) 100%);position:relative}.donut:after{content:'';position:absolute;inset:52px;background:#fff;border-radius:50%}.dcenter{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#0b2f6c}.dtotal{font-size:31px;font-weight:800;line-height:1}.dcaption{font-size:11px;font-weight:800;text-align:center;line-height:1.05;margin-top:5px}.pct{position:absolute;z-index:4;min-width:56px;padding:5px 9px;border-radius:999px;background:#fff;font-size:17px;font-weight:900;text-align:center;box-shadow:0 3px 9px rgba(10,45,95,.18)}.pct-inc{right:-2px;top:59px;color:#1555ad;border:3px solid #1765c1}.pct-req{left:-3px;bottom:68px;color:#e9610c;border:3px solid #ff7617}.side-legend{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:9px;padding-top:9px;border-top:1px solid #dfe7ef;text-align:center}.sval{font-size:21px;font-weight:800}.sval.blue{color:#1765c1}.sval.orange{color:#ef6b12}.slab{font-size:12px;color:#536579;margin-top:2px}.side-lines{width:100%;margin-top:8px}.side-line{height:48px;display:grid;grid-template-columns:40px 1fr;align-items:center;border-top:1px solid #e1e8f0}.mini{width:33px;height:33px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:18px}.mini.blue{background:#1765c1}.mini.orange{background:#ff7617}.stext{font-size:14.5px;color:#183d70}.stext strong{font-size:16.5px}.stext .blue{color:#1557a5}.stext .orange{color:#ef650e}
.summary{height:92px;margin-top:12px;background:#fff;border:1px solid #d7e3ef;border-radius:17px;box-shadow:0 6px 14px rgba(18,69,124,.09);display:grid;grid-template-columns:330px 1fr;align-items:center;padding:9px 24px}.sum-left{height:66px;display:flex;align-items:center;gap:18px;border-right:2px solid #6da0df;padding-right:22px}.sum-icon{width:62px;height:62px;border-radius:50%;background:linear-gradient(145deg,#247ed6,#124ca6);display:flex;align-items:center;justify-content:center}.sum-icon svg{width:36px;height:36px;stroke:#fff;fill:none;stroke-width:2.1}.sum-label{font-size:21px;font-weight:800;color:#0b2f6c;line-height:1.08}.sum-lines{padding-left:30px;display:grid;gap:8px;font-size:16px;color:#173b77}.sum-line{display:flex;align-items:center;gap:10px}.check{width:22px;height:22px;border-radius:50%;background:#1556b6;color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;flex:0 0 auto}
.footer{position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);color:#fff;display:flex;align-items:center;padding-left:50px;overflow:hidden}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:15px;font-size:22px;letter-spacing:.2px}.footer-inner strong{font-size:25px;letter-spacing:.5px}.footer-globe{width:34px;height:34px}.footer-globe svg{width:34px;height:34px;stroke:#fff;fill:none;stroke-width:2}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#ff6f12;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
const _mesCorto = typeof mesCorto !== 'undefined' ? mesCorto : 'JULIO';
const months = (Array.isArray(typeof series !== 'undefined' ? series : []) ? series : []).map(d => ({
  mes: String(d.mes || d.periodo || ''),
  incidentes: Number(d.incidentes || 0),
  requerimientos: Number(d.requerimientos || 0),
  total: Number(d.total || 0) || Number(d.incidentes || 0) + Number(d.requerimientos || 0)
}));
const lastMonth = months[months.length - 1] || {incidentes:0,requerimientos:0,total:0};
const _incidentesMes = Number(typeof incidentesMes !== 'undefined' ? incidentesMes : lastMonth.incidentes);
const _requerimientosMes = Number(typeof requerimientosMes !== 'undefined' ? requerimientosMes : lastMonth.requerimientos);
const _totalMes = Number(typeof totalMes !== 'undefined' ? totalMes : lastMonth.total) || (_incidentesMes + _requerimientosMes);
const sumInc = months.reduce((a,d)=>a+d.incidentes,0);
const sumReq = months.reduce((a,d)=>a+d.requerimientos,0);
const _acumuladoInc = Number(typeof acumuladoIncidentes !== 'undefined' ? acumuladoIncidentes : sumInc);
const _acumuladoReq = Number(typeof acumuladoRequerimientos !== 'undefined' ? acumuladoRequerimientos : sumReq);
const _acumuladoTotal = Number(typeof acumuladoTotal !== 'undefined' ? acumuladoTotal : (_acumuladoInc + _acumuladoReq));
const _pctIncAcum = Number(typeof pctIncidentesAcum !== 'undefined' ? pctIncidentesAcum : (_acumuladoTotal ? _acumuladoInc / _acumuladoTotal * 100 : 0));
const _pctReqAcum = Number(typeof pctRequerimientosAcum !== 'undefined' ? pctRequerimientosAcum : (_acumuladoTotal ? _acumuladoReq / _acumuladoTotal * 100 : 0));
const _rango = typeof rangoPeriodo !== 'undefined' ? rangoPeriodo : 'ago-25 a jul-26';
const maxVal = Math.max(200, Math.ceil(Math.max(...months.flatMap(d=>[d.incidentes,d.requerimientos]), Number(typeof maxSerie !== 'undefined' ? maxSerie : 0), 1)/200)*200);
function nfmt(v){ return Number(v || 0).toLocaleString('en-US'); }
%>
<div class="slide">
  <div class="brand"><div class="brand-mark"><span class="brand-globe"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg></span><span class="brand-word">COMM</span></div></div>
  <header class="header"><div class="title">Incidentes vs Requerimientos VOLCAN</div><div class="underline"></div></header>
  <section class="kpis">
    <div class="kpi" style="--c1:#1b61b9;--c2:#0a438e;--tc:#1554a1"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M14 8h20v32H14z"/><path d="M19 5h10v7H19zM19 18h10M19 24h10M19 30h7"/></svg></div><div class="kcontent"><div class="kname">TOTAL <%= _mesCorto %></div><div class="kvalue"><%= nfmt(_totalMes) %></div></div></div>
    <div class="kpi" style="--c1:#2b80dc;--c2:#1554b5;--tc:#1554a9"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M24 5 39 11v11c0 10-6 17-15 21C15 39 9 32 9 22V11l15-6Z"/><path d="M24 15v10M24 31h.01"/></svg></div><div class="kcontent"><div class="kname">INCIDENTES (<%= _mesCorto %>)</div><div class="kvalue"><%= nfmt(_incidentesMes) %></div></div></div>
    <div class="kpi" style="--c1:#ff8629;--c2:#f05c0c;--tc:#ef650e"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M14 8h20v32H14z"/><path d="M19 5h10v7H19zM19 18h10M19 24h10M19 30h7"/></svg></div><div class="kcontent"><div class="kname">REQUERIMIENTOS (<%= _mesCorto %>)</div><div class="kvalue"><%= nfmt(_requerimientosMes) %></div></div></div>
    <div class="kpi" style="--c1:#56a7e8;--c2:#2677c7;--tc:#1a63b0"><div class="kicon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"/><path d="M24 7v17h17"/></svg></div><div class="kcontent"><div class="kname">% INCIDENTES</div><div class="kvalue"><%= _pctIncAcum.toFixed(0) %>%</div><div class="ksub">acumulado 12 meses</div></div></div>
    <div class="kpi" style="--c1:#ff942e;--c2:#f2670c;--tc:#ef680c"><div class="kicon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"/><path d="M24 7v17l13 10"/></svg></div><div class="kcontent"><div class="kname">% REQUERIMIENTOS</div><div class="kvalue"><%= _pctReqAcum.toFixed(0) %>%</div><div class="ksub">acumulado 12 meses</div></div></div>
  </section>
  <section class="main">
    <div class="panel trend"><div class="panel-title">VOLCAN</div>
      <% const w=780,h=345,ml=58,mr=28,mt=24,mb=48,pw=w-ml-mr,ph=h-mt-mb; const sx=i=>ml+(months.length<=1?pw/2:i*pw/(months.length-1)); const sy=v=>mt+ph-(Number(v||0)/maxVal)*ph; const barW=24; const reqPts=months.map((d,i)=>`${sx(i)},${sy(d.requerimientos)}`).join(' '); %>
      <svg class="chart-svg" viewBox="0 0 780 345">
        <% for(let t=0;t<=maxVal;t+=200){const y=sy(t); %><line class="grid" x1="<%= ml %>" y1="<%= y %>" x2="<%= w-mr %>" y2="<%= y %>"/><text class="axis" x="<%= ml-12 %>" y="<%= y+4 %>" text-anchor="end"><%= t %></text><% } %>
        <% months.forEach((d,i)=>{ const x=sx(i)-barW/2; const y=sy(d.incidentes); const hh=mt+ph-y; %><rect x="<%= x %>" y="<%= y %>" width="<%= barW %>" height="<%= hh %>" fill="#1765c1"/><text class="value-inc" x="<%= sx(i) %>" y="<%= y + Math.max(13, hh/2) %>"><%= d.incidentes %></text><text class="axis" x="<%= sx(i) %>" y="<%= h-17 %>" text-anchor="middle"><%= d.mes %></text><% }) %>
        <polyline points="<%= reqPts %>" fill="none" stroke="#ef6b12" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"/>
        <% months.forEach((d,i)=>{ %><circle cx="<%= sx(i) %>" cy="<%= sy(d.requerimientos) %>" r="5.5" fill="#ef6b12"/><text class="value-req" x="<%= sx(i) %>" y="<%= Math.max(mt+13,sy(d.requerimientos)-11) %>"><%= d.requerimientos %></text><% }) %>
        <text class="axis" x="17" y="174" transform="rotate(-90 17 174)" text-anchor="middle" style="font-size:14px;font-weight:800">ATENCIONES</text>
      </svg><div class="legend"><div class="leg"><span class="legbox"></span>Incidente</div><div class="leg"><span class="legline"></span>Requerimiento</div></div>
    </div>
    <div class="panel table-panel"><div class="table-title">DETALLE MENSUAL</div><table class="data-table"><thead><tr><th>Mes</th><th>Incidente</th><th>Requerimiento</th><th>Total</th></tr></thead><tbody><% months.forEach(d=>{ %><tr><td><%= d.mes %></td><td><%= nfmt(d.incidentes) %></td><td><%= nfmt(d.requerimientos) %></td><td><%= nfmt(d.total) %></td></tr><% }) %></tbody><tfoot><tr><td>Total general</td><td><%= nfmt(_acumuladoInc) %></td><td><%= nfmt(_acumuladoReq) %></td><td><%= nfmt(_acumuladoTotal) %></td></tr></tfoot></table></div>
    <div class="panel side"><div class="side-title">ACUMULADO 12 MESES</div><div class="side-sub"><%= _rango %></div><div class="donut" style="--inc:<%= _pctIncAcum.toFixed(2) %>%"><div class="dcenter"><div class="dtotal"><%= nfmt(_acumuladoTotal) %></div><div class="dcaption">ATENCIONES<br>ACUMULADAS</div></div><span class="pct pct-inc"><%= _pctIncAcum.toFixed(0) %>%</span><span class="pct pct-req"><%= _pctReqAcum.toFixed(0) %>%</span></div><div class="side-legend"><div><div class="sval blue"><%= nfmt(_acumuladoInc) %></div><div class="slab">Incidentes</div></div><div><div class="sval orange"><%= nfmt(_acumuladoReq) %></div><div class="slab">Requerimientos</div></div></div><div class="side-lines"><div class="side-line"><div class="mini blue">!</div><div class="stext"><span class="blue"><b>INCIDENTES:</b></span> <strong><%= nfmt(_acumuladoInc) %></strong></div></div><div class="side-line"><div class="mini orange">✓</div><div class="stext"><span class="orange"><b>REQUERIMIENTOS:</b></span> <strong><%= nfmt(_acumuladoReq) %></strong></div></div></div></div>
  </section>
  <section class="summary"><div class="sum-left"><div class="sum-icon"><svg viewBox="0 0 48 48"><path d="M10 36h28M14 33V22m8 11V15m8 18V25m8 8V12"/><path d="M13 23l9-8 8 9 8-12"/></svg></div><div class="sum-label">RESUMEN<br>EJECUTIVO</div></div><div class="sum-lines"><div class="sum-line"><span class="check">✓</span>En <%= _mesCorto.charAt(0).toUpperCase()+_mesCorto.slice(1).toLowerCase() %> 2026, VOLCAN registró <%= nfmt(_totalMes) %> atenciones: <%= nfmt(_incidentesMes) %> incidentes y <%= nfmt(_requerimientosMes) %> requerimientos.</div><div class="sum-line"><span class="check">✓</span>En el acumulado de 12 meses se registran <%= nfmt(_acumuladoTotal) %> atenciones: los requerimientos representan <%= _pctReqAcum.toFixed(0) %>% y los incidentes <%= _pctIncAcum.toFixed(0) %>%.</div></div></section>
  <footer class="footer"><div class="footer-inner"><span class="footer-globe"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg></span><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><span class="footer-orange"></span></footer>
</div>
<style id="slide19-donut-label-position-fix">
.side .donut .pct-inc,.donut .pct-inc{right:-2px!important;top:59px!important;color:#1555ad!important;border-color:#1765c1!important}
.side .donut .pct-req,.donut .pct-req{left:-3px!important;bottom:68px!important;color:#e9610c!important;border-color:#ff7617!important}
</style>
</body>
</html>