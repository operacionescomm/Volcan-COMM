<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:1600px;height:900px;overflow:hidden}
body{font-family:Arial,Helvetica,sans-serif;background:linear-gradient(135deg,#fff 0%,#f8fbff 72%,#eef5ff 100%);color:#0b2d67}
.slide{position:relative;width:1600px;height:900px;padding:24px 40px 78px;overflow:hidden}
.brand{position:absolute;right:0;top:0;width:390px;height:106px;border-bottom-left-radius:230px 105px;background:linear-gradient(145deg,#0f4d98,#073b7c 58%,#062f67);display:flex;align-items:center;justify-content:flex-end;padding-right:42px;color:#fff;box-shadow:inset 18px 0 0 rgba(63,145,229,.22)}
.brand-word{font-size:39px;font-weight:800;letter-spacing:2px}
.header{height:104px;padding-right:410px}
.title{font-size:42px;line-height:1.05;font-weight:800;color:#092766;letter-spacing:.1px;white-space:nowrap}
.subtitle{margin-top:12px;display:flex;align-items:center;gap:10px;font-size:18px;color:#294777;font-weight:600}
.calendar{width:23px;height:23px;border:3px solid #1763c6;border-radius:5px;position:relative;flex:0 0 auto}
.calendar:before{content:'';position:absolute;left:2px;right:2px;top:6px;height:3px;background:#1763c6}
.calendar:after{content:'';position:absolute;left:5px;right:5px;top:-6px;height:8px;border-left:3px solid #1763c6;border-right:3px solid #1763c6}
.kpis{height:145px;display:grid;grid-template-columns:1.1fr 1fr 1.16fr 1fr 1.1fr;gap:16px;margin-top:4px}
.kpi{height:132px;background:#fff;border:1px solid #d8e3ef;border-radius:18px;box-shadow:0 8px 18px rgba(18,67,121,.11);display:grid;grid-template-columns:66px minmax(0,1fr);align-items:center;padding:11px 14px;overflow:hidden}
.kicon{width:62px;height:62px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,var(--c1),var(--c2));box-shadow:0 6px 14px rgba(17,62,118,.18)}
.kicon svg{width:36px;height:36px;fill:none;stroke:#fff;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.kcontent{padding-left:9px;min-width:0}.kname{font-size:14px;line-height:1.08;font-weight:800;color:var(--tc);text-transform:uppercase}.kvalue{font-size:38px;line-height:1;font-weight:800;color:var(--tc);margin-top:7px;white-space:nowrap}.ksub{font-size:12px;color:#58697f;margin-top:4px;white-space:nowrap}
.main{height:440px;display:grid;grid-template-columns:2.15fr .95fr;gap:18px;margin-top:5px}.panel{background:#fff;border:1px solid #d8e5f1;border-radius:19px;box-shadow:0 8px 18px rgba(18,67,121,.10);overflow:hidden}.trend{padding:15px 18px 10px}.ptitle{height:46px;display:flex;align-items:center;gap:11px;font-size:19px;font-weight:800;color:#0c2e6a}.picon{width:40px;height:40px;border-radius:50%;background:linear-gradient(145deg,#2c8fe1,#1653b8);display:flex;align-items:center;justify-content:center;flex:0 0 auto}.picon svg{width:24px;height:24px;fill:none;stroke:#fff;stroke-width:2.2}.chart-svg{width:100%;height:335px;display:block;overflow:visible}.grid{stroke:#d2dce7;stroke-width:1;stroke-dasharray:5 4}.axis{font-size:12px;fill:#24446f;font-weight:600}.value-inc{font-size:12px;fill:#154f9f;font-weight:800;text-anchor:middle;paint-order:stroke;stroke:#fff;stroke-width:4px}.value-req{font-size:12px;fill:#ef6b12;font-weight:800;text-anchor:middle;paint-order:stroke;stroke:#fff;stroke-width:4px}.legend{display:flex;justify-content:center;gap:28px;margin-top:-3px;font-size:13px;font-weight:700;color:#24446f}.leg{display:flex;align-items:center;gap:7px}.box{width:17px;height:11px;background:#1765c1}.line{width:27px;height:4px;background:#ef6b12;border-radius:3px;position:relative}.line:after{content:'';position:absolute;width:8px;height:8px;border-radius:50%;background:#ef6b12;left:10px;top:-2px}
.donut-panel{padding:15px 20px 12px;display:flex;flex-direction:column;align-items:center}.donut-title{font-size:20px;font-weight:800;color:#0b2e6a;margin-top:2px}.donut-sub{font-size:13px;color:#697c92;margin-top:4px;font-weight:700}.donut{width:238px;height:238px;border-radius:50%;margin-top:15px;background:conic-gradient(#1765c1 0 var(--inc),#ff7617 var(--inc) 100%);position:relative;box-shadow:inset 0 0 0 1px rgba(0,0,0,.04)}.donut:after{content:'';position:absolute;inset:58px;background:#fff;border-radius:50%;box-shadow:0 0 0 1px #e3eaf2}.dcenter{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#0b2e6a}.dtotal{font-size:34px;font-weight:800}.dcaption{font-size:11px;font-weight:800;letter-spacing:.4px;text-align:center;line-height:1.15}.pctlabels{position:absolute;inset:0;z-index:4;pointer-events:none}.pct-inc,.pct-req{position:absolute;min-width:64px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.98);font-size:19px;font-weight:900;text-align:center;box-shadow:0 3px 9px rgba(10,45,95,.22)}.pct-inc{right:8px;top:50px;color:#e9610c;border:3px solid #ff7617}.pct-req{left:10px;bottom:38px;color:#1555ad;border:3px solid #1765c1}.dlegend{width:100%;margin-top:16px;border-top:1px solid #dce4ed;padding-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px}.ditem{text-align:center;font-size:13px;color:#405975}.ditem strong{display:block;font-size:20px;margin-bottom:2px}.blue{color:#1765c1}.orange{color:#ef6b12}
.summary{height:96px;margin-top:15px;background:#fff;border:1px solid #d6e4f2;border-radius:17px;box-shadow:0 7px 16px rgba(18,69,124,.09);display:grid;grid-template-columns:255px 1fr;align-items:center;padding:10px 22px}.sum-title{height:66px;display:flex;align-items:center;gap:15px;border-right:2px solid #6da0df;padding-right:20px}.sum-icon{width:60px;height:60px;border-radius:50%;background:linear-gradient(145deg,#278be1,#1551b0);display:flex;align-items:center;justify-content:center}.sum-icon svg{width:34px;height:34px;fill:none;stroke:#fff;stroke-width:2.2}.sum-label{font-size:20px;font-weight:800;color:#0b2d69;line-height:1.08}.sum-lines{padding-left:28px;display:grid;gap:7px;font-size:15.5px;color:#173b77}.sum-line{display:flex;align-items:center;gap:10px}.check{width:21px;height:21px;border-radius:50%;background:#1556b6;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;flex:0 0 auto}
.footer{position:absolute;left:14px;right:14px;bottom:9px;height:62px;border-radius:16px;background:linear-gradient(90deg,#104ea9,#073b7d);display:flex;align-items:center;padding-left:48px;color:#fff;font-size:17px;font-weight:700;letter-spacing:.4px;overflow:hidden}.footer:after{content:'';position:absolute;right:-28px;bottom:-44px;width:185px;height:120px;border-radius:70% 0 0 0;background:#f57c1f;transform:rotate(-5deg)}
</style>
</head>
<body>
<div class="slide">
<div class="brand"><div class="brand-word">COMM</div></div>
<header class="header"><div class="title"><%= titulo %></div><div class="subtitle"><span class="calendar"></span><span>Datos al mes más reciente: <strong><%= periodo %></strong> · Acumulado últimos 12 meses</span></div></header>
<section class="kpis">
<div class="kpi" style="--c1:#1a61b9;--c2:#0a438e;--tc:#154f9f"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M14 8h20v32H14z"/><path d="M19 5h10v7H19zM19 18h10M19 24h10M19 30h7"/></svg></div><div class="kcontent"><div class="kname">TOTAL <%= mesCorto %></div><div class="kvalue"><%= totalMes.toLocaleString('en-US') %></div><div class="ksub">atenciones del mes</div></div></div>
<div class="kpi" style="--c1:#2c83df;--c2:#1555b8;--tc:#1555ad"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M24 5 39 11v11c0 10-6 17-15 21C15 39 9 32 9 22V11l15-6Z"/><path d="M24 15v10M24 31h.01"/></svg></div><div class="kcontent"><div class="kname">INCIDENTES (<%= mesCorto %>)</div><div class="kvalue"><%= incidentesMes.toLocaleString('en-US') %></div></div></div>
<div class="kpi" style="--c1:#ff8629;--c2:#f05c0c;--tc:#ee650e"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M14 8h20v32H14z"/><path d="M19 5h10v7H19zM19 18h10M19 24h10M19 30h7"/></svg></div><div class="kcontent"><div class="kname">REQUERIMIENTOS (<%= mesCorto %>)</div><div class="kvalue"><%= requerimientosMes.toLocaleString('en-US') %></div></div></div>
<div class="kpi" style="--c1:#52a7e8;--c2:#2375c8;--tc:#1a63b0"><div class="kicon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"/><path d="M24 7v17h17"/></svg></div><div class="kcontent"><div class="kname">% INCIDENTES</div><div class="kvalue"><%= pctIncidentesAcum.toFixed(0) %>%</div><div class="ksub">acumulado 12 meses</div></div></div>
<div class="kpi" style="--c1:#ff942e;--c2:#f2670c;--tc:#ef680c"><div class="kicon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="17"/><path d="M24 7v17l13 10"/></svg></div><div class="kcontent"><div class="kname">% REQUERIMIENTOS</div><div class="kvalue"><%= pctRequerimientosAcum.toFixed(0) %>%</div><div class="ksub">acumulado 12 meses</div></div></div>
</section>
<section class="main">
<div class="panel trend">
<div class="ptitle"><span class="picon"><svg viewBox="0 0 32 32"><path d="M4 27V5M4 27h24"/><polyline points="6,22 12,17 17,20 23,10 28,13"/></svg></span>VOLCAN – TENDENCIA DE INCIDENTES VS REQUERIMIENTOS</div>
<% const w=1015,h=322,ml=58,mr=28,mt=24,mb=50,pw=w-ml-mr,ph=h-mt-mb; const ymax=Math.max(100,Math.ceil(maxSerie/200)*200); const sx=i=>ml+(series.length<=1?pw/2:i*pw/(series.length-1)); const sy=v=>mt+ph-(Number(v||0)/ymax)*ph; const barW=28; const reqPts=series.map((d,i)=>`${sx(i)},${sy(d.requerimientos)}`).join(' '); %>
<svg class="chart-svg" viewBox="0 0 1015 322">
<% for(let t=0;t<=ymax;t+=200){const y=sy(t); %><line class="grid" x1="<%= ml %>" y1="<%= y %>" x2="<%= w-mr %>" y2="<%= y %>"/><text class="axis" x="<%= ml-11 %>" y="<%= y+4 %>" text-anchor="end"><%= t %></text><% } %>
<% series.forEach((d,i)=>{ const x=sx(i)-barW/2; %><rect x="<%= x %>" y="<%= sy(d.incidentes) %>" width="<%= barW %>" height="<%= mt+ph-sy(d.incidentes) %>" rx="2" fill="#1765c1"/><text class="value-inc" x="<%= sx(i) %>" y="<%= Math.max(mt+12,sy(d.incidentes)-8) %>"><%= d.incidentes %></text><text class="axis" x="<%= sx(i) %>" y="<%= h-18 %>" text-anchor="middle"><%= d.mes %></text><% }) %>
<polyline points="<%= reqPts %>" fill="none" stroke="#ef6b12" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"/>
<% series.forEach((d,i)=>{ %><circle cx="<%= sx(i) %>" cy="<%= sy(d.requerimientos) %>" r="5.5" fill="#ef6b12"/><text class="value-req" x="<%= sx(i) %>" y="<%= Math.max(mt+13,sy(d.requerimientos)-11) %>"><%= d.requerimientos %></text><% }) %>
<text class="axis" x="15" y="160" transform="rotate(-90 15 160)" text-anchor="middle" style="font-size:14px;font-weight:800">ATENCIONES</text></svg>
<div class="legend"><div class="leg"><span class="box"></span>Incidentes</div><div class="leg"><span class="line"></span>Requerimientos</div></div>
</div>
<div class="panel donut-panel"><div class="donut-title">ACUMULADO 12 MESES</div><div class="donut-sub"><%= rangoPeriodo %></div><div class="donut" style="--inc:<%= pctIncidentesAcum.toFixed(2) %>%"><div class="dcenter"><div class="dtotal"><%= acumuladoTotal.toLocaleString('en-US') %></div><div class="dcaption">ATENCIONES<br>ACUMULADAS</div></div><div class="pctlabels"><span class="pct-inc"><%= pctIncidentesAcum.toFixed(0) %>%</span><span class="pct-req"><%= pctRequerimientosAcum.toFixed(0) %>%</span></div></div><div class="dlegend"><div class="ditem"><strong class="blue"><%= acumuladoIncidentes.toLocaleString('en-US') %></strong>Incidentes</div><div class="ditem"><strong class="orange"><%= acumuladoRequerimientos.toLocaleString('en-US') %></strong>Requerimientos</div></div></div>
</section>
<section class="summary"><div class="sum-title"><div class="sum-icon"><svg viewBox="0 0 48 48"><path d="M9 38V25h7v13M21 38V18h7v20M33 38V10h7v28"/><path d="m8 18 10-8 8 4 13-9"/></svg></div><div class="sum-label">RESUMEN<br>EJECUTIVO</div></div><div class="sum-lines"><div class="sum-line"><span class="check">✓</span><span><%= resumen1 %></span></div><div class="sum-line"><span class="check">✓</span><span><%= resumen2 %></span></div></div></section>
<footer class="footer">www.COMMUNICATIONS.com.pe</footer>
</div>
</body>
</html>
