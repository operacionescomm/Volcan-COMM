<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/public/styles.css" />
  <link rel="stylesheet" href="/public/comm-standard.css" />
</head>
<body>
  <main class="dashboard">
    <header class="header">
      <div>
        <div class="eyebrow">Reporte operativo · <%= scopeLabel %></div>
        <h1 class="title"><%= scopeTitulo %> · INCIDENTES VS REQUERIMIENTOS</h1>
        <div class="subtitle"><%= periodo %> · Seguimiento de atenciones operativas</div>
      </div>
      <div class="logo">
        <span class="comm-logo-mark">COMM<small>COMMUNICATIONS</small></span>
      </div>
    </header>

    <section class="content">
      <div class="kpi-grid">
        <article class="kpi">
          <div class="kpi-label">Atenciones totales</div>
          <div class="kpi-value"><%= totalAtenciones.toLocaleString('es-PE') %></div>
          <div class="kpi-note">Incidentes + requerimientos</div>
        </article>

        <article class="kpi kpi-orange">
          <div class="kpi-label">Incidentes</div>
          <div class="kpi-value"><%= incidentes.toLocaleString('es-PE') %></div>
          <div class="kpi-note"><%= pctIncidentes %> del total</div>
        </article>

        <article class="kpi">
          <div class="kpi-label">Requerimientos</div>
          <div class="kpi-value"><%= requerimientos.toLocaleString('es-PE') %></div>
          <div class="kpi-note"><%= pctRequerimientos %> del total</div>
        </article>

        <article class="kpi kpi-sky">
          <div class="kpi-label">% Incidentes</div>
          <div class="kpi-value"><%= pctIncidentes %></div>
          <div class="kpi-note">Participación del periodo</div>
        </article>

        <article class="kpi kpi-sky">
          <div class="kpi-label">% Requerimientos</div>
          <div class="kpi-value"><%= pctRequerimientos %></div>
          <div class="kpi-note">Participación del periodo</div>
        </article>
      </div>

      <div class="main-grid">
        <article class="card">
          <div class="card-header">
            <div class="card-title">Distribución por unidad minera</div>
            <div class="comm-badge"><%= scopeNombre %></div>
          </div>

          <div class="chart-area">
            <div class="legend">
              <span class="legend-item"><i class="legend-dot" style="background:#1d70b7"></i> Requerimientos</span>
              <span class="legend-item"><i class="legend-dot" style="background:#ed862f"></i> Incidentes</span>
            </div>

            <div class="rows-chart">
              <% rows.forEach(row => { %>
                <div class="chart-row">
                  <div class="unit-name"><%= row.unidad %></div>
                  <div class="bar-stack">
                    <div class="track">
                      <div class="bar req" style="width:<%= Math.max(1, (row.requerimientos / maxTotal) * 100) %>%"></div>
                    </div>
                    <div class="track">
                      <div class="bar inc" style="width:<%= Math.max(1, (row.incidentes / maxTotal) * 100) %>%"></div>
                    </div>
                  </div>
                  <div class="row-total"><%= row.total %></div>
                </div>
              <% }) %>
            </div>

            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Unidad minera</th>
                    <th>Incidentes</th>
                    <th>Requerimientos</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  <% rows.forEach(row => { %>
                    <tr>
                      <td><%= row.unidad %></td>
                      <td><%= row.incidentes %></td>
                      <td><%= row.requerimientos %></td>
                      <td><%= row.total %></td>
                    </tr>
                  <% }) %>
                  <tr class="total-row">
                    <td>TOTAL <%= scopeNombre %></td>
                    <td><%= incidentes %></td>
                    <td><%= requerimientos %></td>
                    <td><%= totalAtenciones %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </article>

        <article class="card donut-card">
          <div class="card-header">
            <div class="card-title">Composición de atenciones</div>
            <div class="card-tag"><%= periodo %></div>
          </div>

          <div class="donut-wrap">
            <div class="donut" style="--inc:<%= pctIncidentesNum.toFixed(2) %>%">
              <div class="donut-center">
                <div class="donut-total"><%= totalAtenciones %></div>
                <div class="donut-caption">Atenciones</div>
              </div>
            </div>
          </div>

          <div class="share-grid">
            <div class="share-box">
              <div class="share-value"><%= pctRequerimientos %></div>
              <div class="share-label">Requerimientos</div>
            </div>
            <div class="share-box">
              <div class="share-value"><%= pctIncidentes %></div>
              <div class="share-label">Incidentes</div>
            </div>
          </div>

          <div style="padding:12px 22px 0; text-align:center; color:#718096; font-size:11px; font-weight:700; line-height:1.4;">
            Brecha operativa: <strong style="color:#0b2f5d"><%= Math.abs(brecha) %></strong> atenciones entre requerimientos e incidentes.
          </div>
        </article>
      </div>

      <section class="insight">
        <div class="insight-label">Resumen ejecutivo</div>
        <div class="insight-text"><%= insight %></div>
      </section>
    </section>

    <footer class="footer">
      <span>VOLCAN · COMM · Dashboard automatizado v0.1</span>
      <span>www.COMMUNICATIONS.com.pe</span>
    </footer>
  </main>
</body>
</html>
