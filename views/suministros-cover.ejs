<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<style>
  :root{--navy:#17366f;--blue:#2f5fae;--orange:#e8752a;--grid:#dfe7f1;--text:#0f1d3a;--muted:#6b778d}
  *{box-sizing:border-box} body{margin:0;background:#fff;font-family:Arial,Helvetica,sans-serif;color:var(--text)}
  .slide{position:relative;width:1600px;height:900px;overflow:hidden;background:linear-gradient(120deg,#fff 0%,#fff 54%,#f5f8fc 100%)}
  .brand{position:absolute;right:0;top:0;width:395px;height:86px;background:linear-gradient(145deg,#0d478e,#073772);border-bottom-left-radius:210px 92px;color:#fff;display:flex;align-items:center;justify-content:flex-end;padding-right:44px;gap:16px}
  .brand svg{width:43px;height:43px;stroke:#fff;fill:none;stroke-width:2.2}.brand b{font-size:40px;letter-spacing:.5px}
  .accent{position:absolute;top:31px;left:1080px;width:92px;height:5px;background:var(--orange);border-radius:12px}
  .content{position:absolute;left:94px;top:210px;width:980px}.title{font-size:55px;font-weight:900;letter-spacing:3px;color:var(--navy)}
  .underline{width:150px;height:6px;background:var(--orange);border-radius:12px;margin:34px 0 34px}.subtitle{font-size:20px;line-height:1.3;font-weight:700;color:var(--muted)}
  .cards{display:flex;gap:42px;margin-top:48px}.card{width:270px;height:155px;border:1.5px solid #dbe5ef;border-radius:18px;background:#fff;box-shadow:0 12px 28px rgba(20,45,85,.08);display:flex;flex-direction:column;align-items:center;justify-content:center}.icon{width:70px;height:70px;background:#eef4fc;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:31px;color:var(--blue);font-weight:900}.card b{margin-top:18px;font-size:26px;color:var(--navy)}
  .visual{position:absolute;right:80px;top:180px;width:520px;height:490px;opacity:.52}.visual svg{width:100%;height:100%}.visual .poly{fill:#bcc3cc}.visual .line{stroke:#d6e0ef;stroke-width:3}.visual .dot{fill:#dfe9f7}
  .footer{position:absolute;left:45px;right:45px;bottom:25px;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);display:flex;align-items:center;padding-left:30px;color:#fff}.footer svg{width:34px;height:34px;stroke:#fff;fill:none;stroke-width:2;margin-right:18px}.footer span{font-size:24px;font-weight:800;margin-left:12px}.footer:after{content:'';position:absolute;right:-26px;bottom:-28px;width:180px;height:105px;background:var(--orange);border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<div class="slide">
  <div class="brand"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><b>COMM</b></div>
  <div class="accent"></div>
  <section class="content">
    <div class="title"><%= title %></div>
    <div class="underline"></div>
    <div class="subtitle"><%= subtitle %><br><%= period %></div>
    <div class="cards">
      <div class="card"><div class="icon">Σ</div><b><%= cards[0] %></b></div>
      <div class="card"><div class="icon">$</div><b><%= cards[1] %></b></div>
      <div class="card"><div class="icon">%</div><b><%= cards[2] %></b></div>
    </div>
  </section>
  <div class="visual"><svg viewBox="0 0 520 490"><polygon class="poly" points="90,160 400,60 360,330"/><polygon class="poly" points="25,320 300,250 520,130"/><polygon class="poly" points="60,430 470,390 250,290"/><path class="line" d="M90 160L25 320L250 290L400 60L470 390L60 430L520 130L360 330"/><g><circle class="dot" cx="90" cy="160" r="10"/><circle class="dot" cx="400" cy="60" r="10"/><circle class="dot" cx="25" cy="320" r="10"/><circle class="dot" cx="250" cy="290" r="10"/><circle class="dot" cx="520" cy="130" r="10"/><circle class="dot" cx="470" cy="390" r="10"/><circle class="dot" cx="60" cy="430" r="10"/></g></svg></div>
  <footer class="footer"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.COMMUNICATIONS.com.pe</span></footer>
</div>
</body>
</html>
