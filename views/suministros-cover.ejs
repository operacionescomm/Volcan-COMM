<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1600, initial-scale=1.0" />
  <title>Slide 43 - Suministros</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin:0; width:1600px; height:900px; overflow:hidden; font-family:Arial,Helvetica,sans-serif; background:#000; }
    .slide { position:relative; width:1600px; height:900px; overflow:hidden; color:#fff; background:
      linear-gradient(90deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.55) 28%, rgba(7,44,105,0.18) 55%, rgba(7,44,105,0.08) 100%),
      radial-gradient(circle at 72% 35%, rgba(79,140,255,0.30) 0%, rgba(79,140,255,0.12) 28%, rgba(79,140,255,0) 58%),
      linear-gradient(135deg, #020812 0%, #06204a 52%, #0a2f69 100%); }
    .glow-1,.glow-2,.glow-3 { position:absolute; border-radius:50%; filter:blur(10px); opacity:.25; background:rgba(110,170,255,.35); }
    .glow-1 { width:180px; height:180px; left:760px; top:205px; }
    .glow-2 { width:110px; height:110px; left:1130px; top:150px; opacity:.22; }
    .glow-3 { width:90px; height:90px; left:1320px; top:285px; opacity:.18; }
    .mesh { position:absolute; inset:0; opacity:.22; pointer-events:none; }
    .comm { position:absolute; top:28px; right:42px; width:445px; height:118px; display:flex; align-items:flex-start; justify-content:flex-end; color:#fff; z-index:3; }
    .comm-lockup { display:flex; align-items:flex-start; gap:14px; }
    .comm-icon { width:78px; height:78px; margin-top:2px; position:relative; }
    .comm-icon::before,.comm-icon::after { content:""; position:absolute; inset:0; border-radius:50%; border:5px dashed rgba(255,255,255,.95); clip-path:polygon(8% 0%,100% 0%,100% 100%,0% 100%); transform:skewX(-12deg); }
    .comm-text { text-align:left; line-height:1; }
    .comm-text .brand { font-size:64px; font-weight:800; letter-spacing:-1px; }
    .comm-text .sub1 { margin-top:3px; font-size:25px; font-weight:700; letter-spacing:.2px; }
    .comm-text .sub2 { margin-top:6px; font-size:17px; font-weight:700; opacity:.92; letter-spacing:.2px; }
    .big-number { position:absolute; left:218px; top:302px; font-size:330px; font-weight:300; line-height:.82; color:rgba(120,185,255,.88); letter-spacing:-8px; z-index:2; }
    .big-number.reflect { top:487px; opacity:.10; transform:scaleY(-1); filter:blur(1px); }
    .divider { position:absolute; left:628px; top:311px; width:5px; height:235px; background:rgba(255,255,255,.95); z-index:2; }
    .title-wrap { position:absolute; left:685px; top:393px; z-index:2; width:840px; }
    .title { font-size:90px; font-weight:300; letter-spacing:-1px; line-height:1.02; color:rgba(255,255,255,.98); white-space:nowrap; }
    .line { margin-top:64px; width:800px; height:6px; background:rgba(255,255,255,.95); border-radius:3px; }
  </style>
</head>
<body>
  <div class="slide">
    <div class="glow-1"></div><div class="glow-2"></div><div class="glow-3"></div>
    <svg class="mesh" viewBox="0 0 1600 900" xmlns="http://www.w3.org/2000/svg">
      <g stroke="rgba(170,210,255,0.28)" stroke-width="1.2" fill="none">
        <path d="M980 120 L1140 80 L1310 130 L1450 250 L1420 430 L1280 540 L1100 520 L950 390 Z"/>
        <path d="M1140 80 L1120 240 L1280 330 L1450 250"/>
        <path d="M950 390 L1120 240 L1280 330 L1100 520"/>
        <path d="M980 120 L1120 240"/><path d="M1310 130 L1280 330"/><path d="M1280 540 L1280 330"/>
      </g>
      <g fill="rgba(190,225,255,0.52)"><circle cx="980" cy="120" r="7"/><circle cx="1140" cy="80" r="8"/><circle cx="1310" cy="130" r="7"/><circle cx="1450" cy="250" r="8"/><circle cx="1420" cy="430" r="8"/><circle cx="1280" cy="540" r="7"/><circle cx="1100" cy="520" r="7"/><circle cx="950" cy="390" r="8"/><circle cx="1120" cy="240" r="7"/><circle cx="1280" cy="330" r="7"/></g>
    </svg>
    <div class="comm"><div class="comm-lockup"><div class="comm-icon"></div><div class="comm-text"><div class="brand">COMM</div><div class="sub1">COMMUNICATIONS</div><div class="sub2">AND SYSTEMS DEVELOPMENT</div></div></div></div>
    <div class="big-number">04</div><div class="big-number reflect">04</div><div class="divider"></div>
    <div class="title-wrap"><div class="title">SUMINISTROS</div><div class="line"></div></div>
  </div>
</body>
</html>