<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:1600px;height:900px;overflow:hidden}body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}.slide{position:relative;width:1600px;height:900px;padding:24px 34px 86px;background:linear-gradient(135deg,#fff 0%,#fbfdff 70%,#f4f8fd 100%);overflow:hidden}.brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:30px;color:#fff;z-index:2}.brand-lock{display:flex;align-items:center;gap:12px}.brand svg,.footer svg{stroke:#fff;fill:none}.brand svg{width:42px;height:42px;stroke-width:2.2}.brand-word{font-size:39px;font-weight:900;letter-spacing:1px}.header{height:78px;position:relative;z-index:3;padding-right:420px}.title{font-size:39px;font-weight:900;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:98px;height:5px;border-radius:3px;background:#f26b12;margin-top:12px}.content{height:700px;display:grid;grid-template-columns:1.22fr .95fr;gap:20px}.left{display:grid;grid-template-rows:1fr 1fr;gap:18px}.right{display:grid;grid-template-rows:1fr 150px 1fr;gap:16px}.chart-card,.table-card,.compare-card{background:#fff;border:1px solid #d8e4ef;border-radius:15px;box-shadow:0 6px 14px rgba(18,71,125,.08);overflow:hidden}.chart-card{padding:12px 16px 10px}.chart-head{height:30px;display:flex;align-items:center;justify-content:center;gap:28px}.chart-title{font-size:22px;font-weight:900;color:#0b2f6c;text-transform:uppercase}.legend-inline{display:flex;align-items:center;gap:18px;font-size:11px;font-weight:800;color:#66768a}.leg{display:flex;gap:7px;align-items:center}.legbox{width:17px;height:8px;background:#9fb8d7;border:1px solid #4d8dd3}.legline{width:28px;height:3px;background:#f26b12;position:relative}.legline:after{content:'';position:absolute;left:11px;top:-3px;width:8px;height:8px;border-radius:50%;background:#f26b12}.chart-svg{width:100%;height:270px;display:block;overflow:visible}.grid{stroke:#dbe3ec;stroke-width:1}.axis{font-size:10px;fill:#223e68;font-weight:800}.axis-r{font-size:10px;fill:#2b2b2b;font-weight:800}.cat{font-size:10px;fill:#253e64;font-weight:800}.bar-value{font-size:14px;fill:#fff;font-weight:900;text-anchor:middle}.pct-label{font-size:10px;fill:#ff5a00;font-weight:900;text-anchor:middle}.pct-badge{fill:#fff;stroke:#ff5a00;stroke-width:1.2}.point{fill:#f26b12;stroke:#fff;stroke-width:1.7}.table-title,.compare-title{height:36px;background:linear-gradient(90deg,#062f69,#0a4a98);color:#fff;font-size:15px;font-weight:900;display:flex;align-items:center;justify-content:center;text-transform:uppercase}.data-table{width:100%;border-collapse:collapse;color:#06122a}.data-table th{background:#eef4fb;color:#0b2f6c;padding:8px 7px;font-weight:900;font-size:11.5px;border:1px solid #d3dfeb}.data-table td{border:1px solid #d3dfeb;padding:8px 9px;text-align:center;font-weight:750;font-size:13px}.data-table td:first-child{text-align:left}.data-table.many td{font-size:10.6px;padding:5.5px 7px}.data-table.many th{font-size:10px;padding:6px 5px}.data-table .total td{background:#eef4fb;font-weight:900;text-transform:uppercase}.compare-table{width:100%;border-collapse:collapse}.compare-table th{font-size:11px;color:#0b2f6c;background:#eef4fb;border:1px solid #c4d2e3;padding:7px}.compare-table td{font-size:11.5px;border:1px solid #c4d2e3;padding:7px;text-align:center;font-weight:900}.compare-table td:first-child{text-align:left;color:#0b2f6c}.pos{color:#128536}.footer{position:absolute;left:25px;right:25px;bottom:16px;height:63px;background:linear-gradient(90deg,#2e56a0,#063774);display:flex;align-items:center;padding-left:32px;color:#fff;overflow:hidden}.footer svg{width:30px;height:30px;stroke-width:2}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:17px;font-size:22px;color:rgba(255,255,255,.68);font-weight:800}.footer-inner strong{color:rgba(255,255,255,.72);font-size:25px}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
function fmt(n){return Number(n||0).toLocaleString('en-US')}
function pct(v,d=0){return `${(Number(v||0)*100).toFixed(d)}%`}
function splitLabel(name){const s=String(name||'').trim();const suf=(s.match(/\([^)]*\)$/)||[''])[0];const base=suf?s.replace(/\s*\([^)]*\)$/,''):s;let lines=[];let cur='';base.split(/\s+/).forEach(w=>{if(!cur)cur=w;else if((cur+' '+w).length<=12)cur+=' '+w;else{lines.push(cur);cur=w}});if(cur)lines.push(cur);if(suf)lines.push(suf);return lines.slice(0,4)}
function hasTime(m){return (m.items||[]).some(r=>r.tiempo!==null&&r.tiempo!==undefined)}
function chart(month,label){const rows=(month.items||[]).slice(0,10);const maxCant=Math.max(1,...rows.map(r=>r.cantidad));const yMax=Math.max(1,Math.ceil(maxCant*1.25));const maxPct=Math.max(1,...rows.map(r=>r.pct));const ml=50,mr=48,mt=30,mb=64,w=820,h=270,pw=w-ml-mr,ph=h-mt-mb,n=rows.length||1,slot=pw/n,bw=Math.min(64,slot*.44);const sx=i=>ml+slot*i+slot/2;const sy=v=>mt+ph-(Number(v||0)/yMax)*ph;const syp=v=>mt+ph-(Number(v||0)/maxPct)*ph*.88;%>
<div class="chart-card"><div class="chart-head"><div class="chart-title"><%=label%></div><div class="legend-inline"><span class="leg"><i class="legbox"></i>Cantidad</span><span class="leg"><i class="legline"></i>% participación</span></div></div><svg class="chart-svg" viewBox="0 0 820 270"><text class="axis" x="10" y="24">Incidencias</text><text class="axis" x="755" y="24" text-anchor="end">% Participación</text><% for(let k=0;k<=4;k++){const val=yMax*k/4,y=sy(val);%><line class="grid" x1="<%=ml%>" y1="<%=y%>" x2="<%=w-mr%>" y2="<%=y%>"/><text class="axis" x="<%=ml-8%>" y="<%=y+3%>" text-anchor="end"><%=Math.round(val)%></text><%}%><% [0,.25,.5,.75,1].forEach(p=>{const y=mt+ph-p*ph*.88;%><text class="axis-r" x="<%=w-mr+10%>" y="<%=y+3%>"><%=Math.round(p*100)%>%</text><%})%><% rows.forEach((r,i)=>{const cx=sx(i),y=sy(r.cantidad),hh=mt+ph-y;%><rect x="<%=cx-bw/2%>" y="<%=y%>" width="<%=bw%>" height="<%=hh%>" rx="3" fill="#9fb8d7" stroke="#4d8dd3" stroke-width="1.8"/><text class="bar-value" x="<%=cx%>" y="<%=y+hh/2+5%>"><%=fmt(r.cantidad)%></text><%})%><polyline points="<%=rows.map((r,i)=>`${sx(i)},${syp(r.pct)}`).join(' ')%>" fill="none" stroke="#f26b12" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><% rows.forEach((r,i)=>{const cx=sx(i),py=syp(r.pct),txt=pct(r.pct,0);%><circle class="point" cx="<%=cx%>" cy="<%=py%>" r="4"/><rect class="pct-badge" x="<%=cx-19%>" y="<%=py-24%>" width="38" height="18" rx="7"/><text class="pct-label" x="<%=cx%>" y="<%=py-11%>"><%=txt%></text><% const lines=splitLabel(r.nombre); %><text class="cat" x="<%=cx%>" y="<%=mt+ph+15%>" text-anchor="middle"><% lines.forEach((line,li)=>{%><tspan x="<%=cx%>" dy="<%=li===0?0:11%>"><%=line%></tspan><%})%></text><%})%></svg></div><%}
function table(month,label){const showTime=hasTime(month);const rows=month.items||[];const many=rows.length>5?' many':'';%><div class="table-card"><div class="table-title">CAUSA RAÍZ – <%=label%></div><table class="data-table<%=many%>"><thead><tr><th>CAUSA RAÍZ</th><th>CANTIDAD</th><% if(showTime){%><th>TIEMPO</th><%}%><th>PORCENTAJE</th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%=r.nombre%></td><td><%=fmt(r.cantidad)%></td><% if(showTime){%><td><%=r.tiempo==null?'—':fmt(r.tiempo)%></td><%}%><td><%=pct(r.pct,0)%></td></tr><%})%><tr class="total"><td>TOTAL CERRO DE PASCO</td><td><%=fmt(month.totalIncidentes)%></td><% if(showTime){%><td></td><%}%><td>100%</td></tr></tbody></table></div><%}
const causaJ=(junio.items&&junio.items[0]&&junio.items[0].nombre)||'Cable Roto por Trabajos (TEL)';
const causaL=(julio.items&&julio.items[0]&&julio.items[0].nombre)||causaJ;
%>
<div class="slide">
  <div class="brand"><div class="brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><div class="brand-word">COMM</div></div></div>
  <header class="header"><div class="title"><%= titulo %></div><div class="underline"></div></header>
  <main class="content"><section class="left"><%- chart(junio,'JUNIO') %><%- chart(julio,'JULIO') %></section><section class="right"><%- table(junio,'JUNIO') %><div class="compare-card"><div class="compare-title">COMPARATIVO JUNIO VS JULIO</div><table class="compare-table"><tr><th></th><th>JUNIO</th><th>JULIO</th></tr><tr><td>Total incidentes</td><td><%=fmt(junio.totalIncidentes)%></td><td><%=fmt(julio.totalIncidentes)%></td></tr><tr><td>Variación</td><td>—</td><td class="pos">+<%=fmt(julio.totalIncidentes-junio.totalIncidentes)%></td></tr><tr><td>Causa principal</td><td><%=causaJ%></td><td><%=causaL%></td></tr><tr><td>Participación</td><td><%=pct(junio.items[0]?.pct||1,0)%></td><td><%=pct(julio.items[0]?.pct||1,0)%></td></tr></table></div><%- table(julio,'JULIO') %></section></main>
  <footer class="footer"><div class="footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><div class="footer-orange"></div></footer>
</div>
</body>
</html>