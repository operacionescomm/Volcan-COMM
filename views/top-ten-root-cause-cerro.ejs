<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box} html,body{margin:0;width:1600px;height:900px;overflow:hidden} body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}.slide{position:relative;width:1600px;height:900px;padding:24px 34px 74px;background:linear-gradient(135deg,#fff 0%,#fbfdff 70%,#f4f8fd 100%);overflow:hidden}.brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:30px;color:#fff;z-index:2}.brand-lock{display:flex;align-items:center;gap:12px}.brand svg,.footer svg{stroke:#fff;fill:none}.brand svg{width:42px;height:42px;stroke-width:2.2}.brand-word{font-size:39px;font-weight:900;letter-spacing:1px}.header{height:78px;position:relative;z-index:3;padding-right:420px}.title{font-size:38px;font-weight:900;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:98px;height:5px;border-radius:3px;background:#f26b12;margin-top:14px}.content{height:674px;display:grid;grid-template-columns:1.28fr 1fr;gap:18px;margin-top:4px}.charts{display:grid;grid-template-rows:1fr 1fr;gap:18px}.right{display:grid;grid-template-rows:205px 180px 205px;gap:20px;align-content:center}.chart-card,.table-card,.compare-card{background:#fff;border:1px solid #d8e4ef;border-radius:15px;box-shadow:0 6px 14px rgba(18,71,125,.08);overflow:hidden}.chart-card{padding:12px 18px 8px}.month-title{text-align:center;color:#0b2f6c;font-size:24px;font-weight:900;height:32px}.chart-svg{width:100%;height:262px;display:block;overflow:visible}.grid{stroke:#dbe3ec;stroke-width:1}.axis{font-size:12px;fill:#2a3e5f;font-weight:800}.axis-r{font-size:12px;fill:#2a3e5f;font-weight:800}.cat{font-size:13px;fill:#263b61;font-weight:700}.bar-value{font-size:18px;fill:#fff;font-weight:900;text-anchor:middle}.pct-label{font-size:15px;fill:#0b2f6c;font-weight:900;text-anchor:middle}.data-table{width:100%;border-collapse:collapse;font-size:14px;color:#06122a}.data-table th{background:linear-gradient(90deg,#062f69,#0a4a98);color:#fff;padding:12px 8px;font-weight:900;font-size:14px}.data-table td{border:1px solid #d3dfeb;padding:12px 10px;text-align:center;font-weight:700}.data-table td:first-child{text-align:left}.data-table .total td{background:#eef4fb;font-weight:900;text-transform:uppercase}.compare-card{padding-bottom:10px}.compare-title{height:34px;background:linear-gradient(90deg,#062f69,#0a4a98);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;text-transform:uppercase}.compare-table{width:100%;border-collapse:collapse;color:#06122a;font-size:12px}.compare-table th{padding:8px;color:#0b2f6c;border-bottom:1px solid #d5e1ee}.compare-table td{padding:7px 8px;border-bottom:1px solid #e1e9f2;font-weight:800;text-align:center}.compare-table td:first-child{text-align:left;color:#0b2f6c}.pos{color:#128536}.footer{position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);display:flex;align-items:center;padding-left:54px;color:#fff;overflow:hidden}.footer svg{width:33px;height:33px;stroke-width:2}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:17px;font-size:22px;color:rgba(255,255,255,.62);font-weight:800}.footer-inner strong{color:rgba(255,255,255,.65);font-size:25px}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
function fmt(n){return Number(n||0).toLocaleString('en-US')}
function pct(v){return `${Math.round(Number(v||0)*100)}%`}
function splitLabel(name){const s=String(name||'').trim();const suf=(s.match(/\([^)]*\)$/)||[''])[0];const base=suf?s.replace(/\s*\([^)]*\)$/,''):s;let lines=[];if(/^Cable Roto/i.test(base)){lines=['Cable Roto',base.replace(/^Cable Roto\s*/i,'').trim()]}else lines=[base];if(suf)lines.push(suf);return lines}
function chart(month,label){const rows=month.items||[];const maxCant=Math.max(1,...rows.map(r=>r.cantidad));const yMax=Math.max(1,Math.ceil(maxCant*1.45));const ml=60,mr=56,mt=18,mb=55,w=830,h=262,pw=w-ml-mr,ph=h-mt-mb,n=rows.length||1,slot=pw/n,bw=Math.min(80,slot*.28);const sx=i=>ml+slot*i+slot/2;const sy=v=>mt+ph-(Number(v||0)/yMax)*ph;%>
<div class="chart-card"><div class="month-title"><%=label%></div><svg class="chart-svg" viewBox="0 0 830 262"><% for(let t=0;t<=yMax;t+=0.5){const y=sy(t);%><line class="grid" x1="<%=ml%>" y1="<%=y%>" x2="<%=w-mr%>" y2="<%=y%>"/><text class="axis" x="<%=ml-8%>" y="<%=y+4%>" text-anchor="end"><%=t%></text><%}%><% [0,.2,.4,.6,.8,1].forEach(p=>{const y=mt+ph-(p)*ph;%><text class="axis-r" x="<%=w-mr+10%>" y="<%=y+4%>"><%=Math.round(p*100)%>%</text><%})%><% rows.forEach((r,i)=>{const cx=sx(i),y=sy(r.cantidad),hh=mt+ph-y;%><rect x="<%=cx-bw/2%>" y="<%=y%>" width="<%=bw%>" height="<%=hh%>" rx="2" fill="#9fb8d7" stroke="#4d8dd3" stroke-width="2"/><text class="bar-value" x="<%=cx%>" y="<%=y+hh/2+7%>"><%=fmt(r.cantidad)%></text><text class="pct-label" x="<%=cx%>" y="<%=Math.max(mt+14,y-8)%>"><%=pct(r.pct)%></text><% const lines=splitLabel(r.nombre); %><text class="cat" x="<%=cx%>" y="<%=mt+ph+22%>" text-anchor="middle"><% lines.forEach((line,li)=>{%><tspan x="<%=cx%>" dy="<%=li===0?0:15%>"><%=line%></tspan><%})%></text><%})%></svg></div><%}
function table(month, label, withTime){ const rows=month.items||[]; %>
<div class="table-card"><table class="data-table"><thead><tr><th>CAUSA RAÍZ – <%=label%></th><th>CANTIDAD</th><% if(withTime){ %><th>TIEMPO</th><% } %><th>PORCENTAJE</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%=r.nombre%></td><td><%=fmt(r.cantidad)%></td><% if(withTime){ %><td><%=r.tiempo==null?'':fmt(r.tiempo)%></td><% } %><td><%=pct(r.pct)%></td></tr><% }) %><tr class="total"><td>TOTAL CERRO DE PASCO</td><td><%=fmt(month.totalIncidentes)%></td><% if(withTime){ %><td></td><% } %><td>100%</td></tr></tbody></table></div><% }
%>
<div class="slide">
  <div class="brand"><div class="brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><div class="brand-word">COMM</div></div></div>
  <header class="header"><div class="title"><%= titulo %></div><div class="underline"></div></header>
  <main class="content">
    <section class="charts"><%- chart(junio,'JUNIO') %><%- chart(julio,'JULIO') %></section>
    <section class="right">
      <%- table(junio,'JUNIO',true) %>
      <div class="compare-card"><div class="compare-title">Comparativo Junio vs Julio</div><table class="compare-table"><thead><tr><th></th><th>JUNIO</th><th>JULIO</th></tr></thead><tbody><tr><td>Total incidentes</td><td><%=fmt(junio.totalIncidentes)%></td><td><%=fmt(julio.totalIncidentes)%></td></tr><tr><td>Variación</td><td>—</td><td class="pos">+<%=fmt(julio.totalIncidentes-junio.totalIncidentes)%></td></tr><tr><td>Causa principal</td><td><%=junio.items[0]?.nombre%></td><td><%=julio.items[0]?.nombre%></td></tr><tr><td>Participación</td><td>100%</td><td>100%</td></tr></tbody></table></div>
      <%- table(julio,'JULIO',false) %>
    </section>
  </main>
  <footer class="footer"><div class="footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><div class="footer-orange"></div></footer>
</div>
</body>
</html>
