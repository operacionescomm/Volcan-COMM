.insight.orange{display:grid!important;grid-template-columns:.72fr 1.28fr!important;align-items:center!important;column-gap:15px!important;border-left:0!important;background:rgba(242,107,18,.18)!important;color:#fff!important;font-size:16px!important;line-height:1.24!important;min-height:80px!important}
.insight.orange b{display:block!important;font-size:17.5px!important;line-height:1.10!important;color:#fff!important}
.summary .pos,.summary .neg{color:#fff!important}
</style>`;
