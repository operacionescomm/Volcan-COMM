<%
/*
 * Slides 29–32 reciben los datos dinámicos en las claves históricas
 * `junio` (mes anterior) y `julio` (mes actual). El template base conserva
 * textos legacy Junio/Julio, así que aquí los sustituimos DESPUÉS de renderizar
 * usando los labels reales que manda Apps Script. Los placeholders evitan
 * colisiones cuando, por ejemplo, el mes anterior real es Julio.
 */
function monthNameFrom(month, fallback) {
  const label = String((month && month.label) || '').trim();
  const match = label.match(/^\s*([^:]+)\s*:/);
  return (match && match[1] ? match[1].trim() : fallback);
}

function cap(text) {
  const s = String(text || '');
  return s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : s;
}

const prevName = cap(monthNameFrom(junio, 'Junio'));
const currName = cap(monthNameFrom(julio, 'Julio'));
const prevUpper = prevName.toUpperCase();
const currUpper = currName.toUpperCase();
const prevLower = prevName.toLowerCase();
const currLower = currName.toLowerCase();
const prevAbbr = prevUpper.slice(0, 3);
const currAbbr = currUpper.slice(0, 3);

let rendered = include('top-ten-root-cause-compare-normalized');

// Primero retirar todos los textos legacy a placeholders neutrales.
rendered = rendered
  .replace(/\bJUNIO\b/g, '__PREV_UPPER__')
  .replace(/\bJunio\b/g, '__PREV_TITLE__')
  .replace(/\bjunio\b/g, '__PREV_LOWER__')
  .replace(/\bJUN\b/g, '__PREV_ABBR__')
  .replace(/\bJULIO\b/g, '__CURR_UPPER__')
  .replace(/\bJulio\b/g, '__CURR_TITLE__')
  .replace(/\bjulio\b/g, '__CURR_LOWER__')
  .replace(/\bJUL\b/g, '__CURR_ABBR__');

// Luego insertar los meses reales del payload.
rendered = rendered
  .replace(/__PREV_UPPER__/g, prevUpper)
  .replace(/__PREV_TITLE__/g, prevName)
  .replace(/__PREV_LOWER__/g, prevLower)
  .replace(/__PREV_ABBR__/g, prevAbbr)
  .replace(/__CURR_UPPER__/g, currUpper)
  .replace(/__CURR_TITLE__/g, currName)
  .replace(/__CURR_LOWER__/g, currLower)
  .replace(/__CURR_ABBR__/g, currAbbr);

const overrides = `
<style>
/* Slides 29–32: layout compactado para que tablas, gráficos y resumen no se corten. */
.slide{padding:16px 30px 68px!important}
.header{height:60px!important}
.title{font-size:32px!important}
.underline{margin-top:8px!important}
.kpis{height:76px!important;gap:12px!important;transform:translateY(-12px)!important;margin-top:0!important}
.kpi{grid-template-columns:48px 1fr!important;padding:7px 12px!important;border-radius:13px!important}
.kpi-icon{width:42px!important;height:42px!important;font-size:17px!important}
.kpi-label{font-size:10.2px!important}
.kpi-value{font-size:25px!important}
.kpi-sub{font-size:8.8px!important;white-space:nowrap!important}
.charts{height:328px!important;gap:14px!important;margin-top:-6px!important}
.chart-box{border-radius:13px!important;padding:5px 8px 3px!important;grid-template-rows:24px minmax(0,1fr)!important}
.chart-head{height:23px!important;gap:16px!important}
.chart-title{font-size:17px!important}
.legend-inline{font-size:9px!important;gap:12px!important}
.chart-svg{height:100%!important}
.cat{font-size:6.2px!important}
.axis,.axis-r{font-size:8.4px!important}
.bar-value{font-size:9.5px!important}
.pct-label{font-size:8px!important}
.bottom{height:222px!important;grid-template-columns:1.12fr .76fr 1.12fr!important;gap:10px!important;margin-top:6px!important}
.panel{border-radius:9px!important}
.panel-title{height:22px!important;font-size:10px!important}
.cause-table th{font-size:6.9px!important;padding:3.4px 3px!important}
.cause-table td{font-size:7.05px!important;padding:2.9px 3px!important;line-height:1.04!important}
.cause-table col.causa{width:63%!important}
.cause-table col.cant{width:10%!important}
.cause-table col.tiempo{width:15%!important}
.cause-table col.porcentaje{width:12%!important}
.summary{background:linear-gradient(135deg,#062f69 0%,#0a4a98 55%,#174b9b 100%)!important;border:0!important;border-radius:13px!important;box-shadow:0 7px 16px rgba(7,49,104,.20)!important;color:#fff!important;overflow:hidden!important}
.summary-head{height:30px!important;background:rgba(255,255,255,.08)!important;border-bottom:1px solid rgba(255,255,255,.20)!important;font-size:14.5px!important;letter-spacing:.3px!important;color:#fff!important}
.summary-body{padding:9px 11px!important;color:#fff!important;display:flex!important;flex-direction:column!important;justify-content:center!important;gap:8px!important}
.summary-kpis{display:none!important}
.summary-insights{display:flex!important;flex-direction:column!important;justify-content:center!important;gap:8px!important;height:100%!important}
.insight{border-left:0!important;border-radius:9px!important;background:rgba(255,255,255,.08)!important;padding:9px 10px!important;font-size:12.7px!important;font-weight:800!important;line-height:1.18!important;color:#fff!important;text-align:left!important;min-height:auto!important}
.insight:first-child{display:grid!important;grid-template-columns:.55fr 1.45fr!important;align-items:center!important;column-gap:10px!important;font-size:13.6px!important;line-height:1.16!important;min-height:68px!important;background:rgba(255,255,255,.10)!important}
.insight:first-child b{display:block!important;font-size:14.6px!important;line-height:1.08!important;color:#fff!important}
.insight.orange{display:grid!important;grid-template-columns:.55fr 1.45fr!important;align-items:center!important;column-gap:10px!important;border-left:0!important;background:rgba(242,107,18,.18)!important;color:#fff!important;font-size:12.8px!important;line-height:1.16!important;min-height:58px!important}
.insight.orange b{display:block!important;font-size:13.8px!important;line-height:1.08!important;color:#fff!important}
.summary .pos,.summary .neg{color:#fff!important}
.footer{height:58px!important;padding-left:50px!important}
.footer-inner{gap:16px!important;font-size:20px!important}
.footer-inner strong{font-size:23px!important}
.footer svg{width:30px!important;height:30px!important}
.footer-sep{height:34px!important;margin:0 8px 0 4px!important}
.footer-orange{width:160px!important;height:92px!important;right:-18px!important;bottom:-24px!important}
</style>`;
%>
<%- rendered.replace('</head>', overrides + '</head>') %>
