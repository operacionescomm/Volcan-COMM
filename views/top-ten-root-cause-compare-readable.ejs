  line-height:1.05!important;
  color:#fff!important;
}

.summary .pos,
.summary .neg{
  color:#fff!important;
}

/* Footer estándar COMM: un solo globo */
.footer{
  height:60px!important;
  padding-left:48px!important;
}

.footer-inner{
  gap:16px!important;
  font-size:20px!important;
}

.footer-inner strong{
  font-size:23px!important;
}

.footer svg{
  width:30px!important;
  height:30px!important;
}

.footer-inner svg:nth-of-type(n+2){
