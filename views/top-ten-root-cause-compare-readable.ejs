.bottom{grid-template-columns:1.03fr .94fr 1.03fr!important;gap:12px!important}
.summary{background:linear-gradient(135deg,#062f69 0%,#0a4a98 55%,#174b9b 100%)!important;border:0!important;border-radius:14px!important;box-shadow:0 7px 16px rgba(7,49,104,.20)!important;color:#fff!important;overflow:hidden!important}
.summary-head{height:42px!important;background:rgba(255,255,255,.08)!important;border-bottom:1px solid rgba(255,255,255,.20)!important;font-size:16.5px!important;letter-spacing:.3px!important;color:#fff!important}
.summary-body{padding:14px 16px!important;color:#fff!important;display:flex!important;flex-direction:column!important;justify-content:center!important;gap:13px!important}
.summary-kpis{display:none!important}
.summary-insights{display:flex!important;flex-direction:column!important;justify-content:center!important;gap:13px!important;height:100%!important}
.insight{border-left:0!important;border-radius:10px!important;background:rgba(255,255,255,.08)!important;padding:14px 15px!important;font-size:15.2px!important;font-weight:800!important;line-height:1.28!important;color:#fff!important;text-align:left!important}
