.insight.orange{border-left:0!important;background:rgba(242,107,18,.17)!important;color:#fff!important;font-size:11.3px!important;min-height:62px!important}
.summary .pos,.summary .neg{color:#fff!important}
</style>`;
%>
<%- rendered.replace('</head>', overrides + '</head>') %>
