<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box} html,body{margin:0;width:1600px;height:900px;overflow:hidden} body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}.slide{position:relative;width:1600px;height:900px;padding:18px 30px 72px;background:linear-gradient(135deg,#fff 0%,#fbfdff 70%,#f4f8fd 100%);overflow:hidden}.brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:30px;color:#fff;z-index:2}.brand-lock{display:flex;align-items:center;gap:12px}.brand svg,.footer svg{stroke:#fff;fill:none}.brand svg{width:42px;height:42px;stroke-width:2.2}.brand-word{font-size:39px;font-weight:900;letter-spacing:1px}.header{height:72px;position:relative;z-index:3;padding-right:420px}.title{font-size:35px;font-weight:900;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:92px;height:5px;border-radius:3px;background:#f26b12;margin-top:12px}.cards{height:94px;display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:4px}.card{background:#fff;border:1px solid #d8e4ef;border-radius:14px;box-shadow:0 6px 14px rgba(18,71,125,.10);padding:12px 18px;display:grid;grid-template-columns:54px 1fr;gap:14px;align-items:center}.card-icon{width:54px;height:54px;border-radius:50%;background:linear-gradient(145deg,#236fd1,#0d4ca2);display:flex;align-items:center;justify-content:center;color:#fff}.card-icon svg{width:30px;height:30px;stroke:#fff;fill:none;stroke-width:2.2}.card-title{font-size:19px;font-weight:900;color:#0b2f6c}.metrics{display:grid;grid-template-columns:repeat(3,1fr);margin-top:6px}.metric{border-left:1px solid #c8d6e5;text-align:center}.metric:first-child{border-left:none}.metric-label{font-size:11px;font-weight:800;color:#253e64}.metric-value{font-size:22px;font-weight:900;color:#0b2f6c}.metric-value.orange{color:#f26b12}.charts{height:333px;display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:12px}.chart-box{background:#fff;border:1px solid #d8e4ef;border-radius:14px;box-shadow:0 6px 14px rgba(18,71,125,.08);padding:10px 12px 6px}.chart-head{width:210px;margin:0 auto 2px;height:24px;border-radius:5px;background:linear-gradient(90deg,#052e69,#0b4b9e);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:15px}.chart-svg{width:100%;height:270px;display:block;overflow:visible}.grid{stroke:#dbe3ec;stroke-width:1}.axis{font-size:10px;fill:#223e68;font-weight:800}.axis-r{font-size:10px;fill:#2b2b2b;font-weight:800}.cat{font-size:8.1px;fill:#253e64;font-weight:800}.bar-value{font-size:10px;fill:#fff;font-weight:900;text-anchor:middle}.pct-label{font-size:9.5px;fill:#ff5a00;font-weight:900;text-anchor:middle}.pct-badge{fill:#fff;stroke:#ff5a00;stroke-width:1.2}.point{fill:#f26b12;stroke:#fff;stroke-width:1.7}.bottom{height:194px;display:grid;grid-template-columns:1.25fr 1.35fr .55fr;gap:18px;margin-top:10px}.panel{background:#fff;border:1px solid #d8e4ef;border-radius:10px;overflow:hidden}.panel-title{height:27px;background:linear-gradient(90deg,#062f69,#0a4a98);color:#fff;font-size:13px;font-weight:900;display:flex;align-items:center;justify-content:center;text-transform:uppercase}.small-table{width:100%;border-collapse:collapse;font-size:12px;color:#0b1630}.small-table th{background:#eef4fb;font-size:11px;padding:6px;border:1px solid #c4d2e3}.small-table td{padding:7px;border:1px solid #c4d2e3;text-align:center;font-weight:800}.small-table td:first-child{text-align:left}.pos{color:#128536}.neg{color:#c70e0e}.obs{padding:11px 16px;font-size:12.5px;line-height:1.35;color:#112a55;font-weight:700}.obs-row{display:grid;grid-template-columns:20px 1fr;gap:8px;margin-bottom:10px}.check{width:17px;height:17px;border-radius:50%;background:#0d4a98;color:#fff;font-weight:900;display:flex;align-items:center;justify-content:center;font-size:12px}.legend{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;font-size:12px;font-weight:800}.leg{display:flex;gap:8px;align-items:center}.legbox{width:28px;height:12px;background:#124da5}.legline{width:32px;height:3px;background:#f26b12;position:relative}.legline:after{content:'';position:absolute;left:12px;top:-4px;width:10px;height:10px;border-radius:50%;background:#fff;border:2px solid #f26b12}.footer{position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);display:flex;align-items:center;padding-left:54px;color:#fff;overflow:hidden}.footer svg{width:33px;height:33px;stroke-width:2}.footer-inner{display:flex;align-items:center;gap:17px;font-size:22px;color:rgba(255,255,255,.62);font-weight:800}.footer-inner strong{color:rgba(255,255,255,.65);font-size:25px}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
function fmt(n){return Number(n||0).toLocaleString('en-US')}
function pct(n,d=0){return `${(Number(n||0)*100).toFixed(d)}%`}
function pp(n){return `${n>=0?'+':''}${(n*100).toFixed(1)} pp`}
function signed(n){return `${n>=0?'+':''}${fmt(n)}`}
function splitLabel(name){const s=String(name||'').trim();const suf=(s.match(/\([^)]*\)$/)||[''])[0];const base=suf?s.replace(/\s*\([^)]*\)$/,''):s;let lines=[];if(/^Cable Roto/i.test(base)){lines=['Cable Roto',base.replace(/^Cable Roto\s*/i,'').trim()]}else{let cur='';base.split(/\s+/).forEach(w=>{if(!cur)cur=w;else if((cur+' '+w).length<=13)cur+=' '+w;else{lines.push(cur);cur=w}});if(cur)lines.push(cur)}if(suf)lines.push(suf);return lines.slice(0,4)}
function chartSvg(month,label){const rows=month.items||[];const maxCant=Math.max(1,...rows.map(r=>r.cantidad));const yMax=Math.ceil(maxCant/5)*5||5;const maxPct=Math.max(.30,...rows.map(r=>r.pct));const pctMax=Math.ceil(maxPct/.05)*.05;const pctFloor=-.10;const ml=45,mr=38,mt=26,mb=74,w=720,h=270,pw=w-ml-mr,ph=h-mt-mb,n=rows.length||1,slot=pw/n,bw=Math.min(32,slot*.42);const sx=i=>ml+slot*i+slot/2;const sy=v=>mt+ph-(Number(v||0)/yMax)*ph;const syp=v=>mt+ph-((Number(v||0)-pctFloor)/(pctMax-pctFloor))*ph;%>
<div class="chart-box"><div class="chart-head">TOP TEN – <%= label %></div><svg class="chart-svg" viewBox="0 0 720 270"><text class="axis" x="0" y="17">Incidencias</text><text class="axis" x="665" y="17">% Participación</text><% for(let t=0;t<=yMax;t+=Math.max(1,Math.ceil(yMax/5))){const y=sy(t);%><line class="grid" x1="<%=ml%>" y1="<%=y%>" x2="<%=w-mr%>" y2="<%=y%>"/><text class="axis" x="<%=ml-7%>" y="<%=y+3%>" text-anchor="end"><%=t%></text><%}%><% for(let p=0;p<=pctMax+1e-9;p+=.10){const y=syp(p);%><text class="axis-r" x="<%=w-mr+8%>" y="<%=y+3%>"><%=Math.round(p*100)%>%</text><%}%><% rows.forEach((r,i)=>{const cx=sx(i),y=sy(r.cantidad),hh=mt+ph-y;%><rect x="<%=cx-bw/2%>" y="<%=y%>" width="<%=bw%>" height="<%=hh%>" rx="2" fill="#164fa9"/><text class="bar-value" x="<%=cx%>" y="<%=y+hh/2+4%>"><%=fmt(r.cantidad)%></text><%})%><polyline points="<%=rows.map((r,i)=>`${sx(i)},${syp(r.pct)}`).join(' ')%>" fill="none" stroke="#f26b12" stroke-width="2.7"/><% rows.forEach((r,i)=>{const cx=sx(i),py=syp(r.pct),txt=pct(r.pct,1),tw=Math.max(30,txt.length*6+9);%><circle class="point" cx="<%=cx%>" cy="<%=py%>" r="3.5"/><rect class="pct-badge" x="<%=cx-tw/2%>" y="<%=py-23%>" width="<%=tw%>" height="17" rx="6"/><text class="pct-label" x="<%=cx%>" y="<%=py-10%>"><%=txt%></text><%})%><% rows.forEach((r,i)=>{const cx=sx(i),lines=splitLabel(r.nombre);%><text class="cat" x="<%=cx%>" y="<%=mt+ph+16%>" text-anchor="middle"><% lines.forEach((line,li)=>{%><tspan x="<%=cx%>" dy="<%=li===0?0:10%>"><%=line%></tspan><%})%></text><%})%></svg></div><% }
%>
<div class="slide">
  <div class="brand"><div class="brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><div class="brand-word">COMM</div></div></div>
  <header class="header"><div class="title"><%= titulo %></div><div class="underline"></div></header>
  <section class="cards">
    <% [['JUNIO',junio],['JULIO',julio]].forEach(([label,m])=>{ %>
      <div class="card"><div class="card-icon"><svg viewBox="0 0 32 32"><rect x="6" y="8" width="20" height="18" rx="2"/><path d="M10 5v6M22 5v6M6 14h20M11 18h2M16 18h2M21 18h2M11 22h2M16 22h2"/></svg></div><div><div class="card-title">RESUMEN <%=label%></div><div class="metrics"><div class="metric"><div class="metric-label">Total Incidentes</div><div class="metric-value"><%=fmt(m.totalIncidentes)%></div></div><div class="metric"><div class="metric-label">Incidencias Top Ten</div><div class="metric-value"><%=fmt(m.topTen)%></div></div><div class="metric"><div class="metric-label">% Participación Top Ten</div><div class="metric-value orange"><%=pct(m.pctTopTen,1)%></div></div></div></div></div>
    <% }) %>
  </section>
  <section class="charts"><%- chartSvg(junio,'JUNIO') %><%- chartSvg(julio,'JULIO') %></section>
  <section class="bottom">
    <div class="panel"><div class="panel-title">Comparativo Junio vs Julio</div><table class="small-table"><tr><th></th><th>Total Incidentes</th><th>Incidencias Top Ten</th><th>% Participación Top Ten</th></tr><tr><td>JUNIO</td><td><%=fmt(junio.totalIncidentes)%></td><td><%=fmt(junio.topTen)%></td><td><%=pct(junio.pctTopTen,1)%></td></tr><tr><td>JULIO</td><td><%=fmt(julio.totalIncidentes)%></td><td><%=fmt(julio.topTen)%></td><td><%=pct(julio.pctTopTen,1)%></td></tr><tr><td>VARIACIÓN</td><td class="<%=diffTotal>=0?'pos':'neg'%>"><%=signed(diffTotal)%></td><td class="<%=diffTopTen>=0?'pos':'neg'%>"><%=signed(diffTopTen)%></td><td class="<%=diffPct>=0?'pos':'neg'%>"><%=pp(diffPct)%></td></tr></table></div>
    <div class="panel"><div class="panel-title">Observaciones clave</div><div class="obs"><div class="obs-row"><span class="check">✓</span><span>La participación Top Ten pasó de <b><%=pct(junio.pctTopTen,1)%></b> en junio a <b><%=pct(julio.pctTopTen,1)%></b> en julio (<b><%=pp(diffPct)%></b>).</span></div><div class="obs-row"><span class="check">✓</span><span><b><%= junio.items[0]?.nombre || 'La principal causa' %></b> se mantiene como una causa relevante del ranking comparativo.</span></div></div></div>
    <div class="panel"><div class="panel-title">Leyenda</div><div class="legend"><span class="leg"><i class="legbox"></i>Incidencias</span><span class="leg"><i class="legline"></i>% Participación</span></div></div>
  </section>
  <footer class="footer"><div class="footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><div class="footer-orange"></div></footer>
</div>
</body>
</html>
