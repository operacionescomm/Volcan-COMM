<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:1600px;height:900px;overflow:hidden}body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}.slide{position:relative;width:1600px;height:900px;padding:18px 30px 82px;background:linear-gradient(135deg,#fff 0%,#fbfdff 70%,#f4f8fd 100%);overflow:hidden}.brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:28px;color:#fff;z-index:2}.brand-lock{display:flex;align-items:center;gap:12px}.brand svg,.footer svg{stroke:#fff;fill:none}.brand svg{width:42px;height:42px;stroke-width:2.2}.brand-text{line-height:.9}.brand-text .w1{display:block;font-size:38px;font-weight:900;color:#7da7ec}.brand-text .w2{display:block;margin-top:4px;font-size:16px;font-weight:900;color:#7da7ec}.brand-text .w3{display:block;margin-top:4px;font-size:8px;font-weight:800;color:#d5d5d5}.header{height:66px;position:relative;z-index:3;padding-right:420px}.title{font-size:34px;font-weight:900;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:92px;height:5px;border-radius:3px;background:#f26b12;margin-top:10px}.kpis{height:82px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:2px;position:relative;z-index:4;transform:translateY(-20px)}.kpi{background:#fff;border:1px solid #d8e4ef;border-radius:14px;box-shadow:0 5px 12px rgba(18,71,125,.09);display:grid;grid-template-columns:52px 1fr;align-items:center;padding:8px 14px}.kpi-icon{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;font-weight:900}.kpi.gray .kpi-icon{background:linear-gradient(145deg,#777,#aaa)}.kpi.teal .kpi-icon{background:linear-gradient(145deg,#188b98,#57aeb7)}.kpi.blue .kpi-icon{background:linear-gradient(145deg,#235ac1,#4c79dd)}.kpi.orange .kpi-icon{background:linear-gradient(145deg,#e86317,#f08b42)}.kpi-label{font-size:11px;font-weight:900;text-transform:uppercase;color:#60738c}.kpi-value{font-size:25px;font-weight:900;line-height:1;color:#0b2f6c;margin-top:2px}.kpi-sub{font-size:9.5px;color:#76879b;font-weight:700;margin-top:3px;white-space:nowrap}.kpi.teal .kpi-value{color:#1a7e87}.kpi.blue .kpi-value{color:#315fc3}.kpi.orange .kpi-value{color:#e96b1e}.charts{height:354px;display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px}.chart-box{background:#fff;border:1px solid #d8e4ef;border-radius:14px;box-shadow:0 6px 14px rgba(18,71,125,.08);padding:7px 10px 3px;overflow:hidden}.chart-head{height:27px;display:flex;align-items:center;justify-content:center;gap:24px}.chart-title{font-size:19px;font-weight:900;color:#0b2f6c;text-transform:uppercase}.legend-inline{display:flex;align-items:center;justify-content:center;gap:18px;font-size:10px;font-weight:800;color:#66768a}.leg{display:flex;gap:6px;align-items:center}.legbox{width:17px;height:8px;background:#3f6fc5;border:1px solid #315aa5}.legline{width:27px;height:3px;background:#f26b12;position:relative}.legline:after{content:'';position:absolute;left:10px;top:-3px;width:8px;height:8px;border-radius:50%;background:#f26b12}.chart-svg{width:100%;height:320px;display:block;overflow:visible}.grid{stroke:#dbe3ec;stroke-width:1}.axis{font-size:9.5px;fill:#223e68;font-weight:800}.axis-r{font-size:9.5px;fill:#2b2b2b;font-weight:800}.cat{font-size:7px;fill:#253e64;font-weight:800}.bar-value{font-size:10.4px;fill:#fff;font-weight:900;text-anchor:middle}.pct-label{font-size:9px;fill:#ff5a00;font-weight:900;text-anchor:middle}.pct-badge{fill:#fff;stroke:#ff5a00;stroke-width:1.1}.point{fill:#f26b12;stroke:#fff;stroke-width:1.7}.bottom{height:250px;display:grid;grid-template-columns:1.18fr .64fr 1.18fr;gap:13px;margin-top:9px}.panel{background:#fff;border:1px solid #d8e4ef;border-radius:10px;overflow:hidden;box-shadow:0 5px 12px rgba(18,71,125,.06)}.panel-title{height:24px;background:linear-gradient(90deg,#062f69,#0a4a98);color:#fff;font-size:11.3px;font-weight:900;display:flex;align-items:center;justify-content:center;text-transform:uppercase}.cause-table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:7.1px;color:#0b1630}.cause-table col.causa{width:64%}.cause-table col.cant{width:11%}.cause-table col.tiempo{width:14%}.cause-table col.porcentaje{width:11%}.cause-table th{font-size:6.7px;color:#0b2f6c;padding:4px 4px;text-align:center;font-weight:900;border-bottom:1px solid #d9e3ef}.cause-table th:first-child{text-align:left}.cause-table td{padding:3.1px 4px;border-bottom:1px solid rgba(93,139,224,.13);font-weight:700;text-align:center;vertical-align:top;line-height:1.05}.cause-table td:first-child{text-align:left;font-weight:650;white-space:normal;word-break:normal;overflow-wrap:anywhere}.cause-table tr:last-child td{border-bottom:none}.summary{height:100%;display:grid;grid-template-rows:30px 1fr}.summary-head{background:linear-gradient(135deg,#2d62bd,#174b9b);color:#fff;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11.8px;font-weight:900}.summary-body{padding:8px 9px;color:#173b70;font-size:8.8px;font-weight:700;line-height:1.2}.summary-body p{margin:0 0 7px}.summary-body p:before{content:'✓';display:inline-flex;width:14px;height:14px;border-radius:50%;background:#315fc3;color:#fff;align-items:center;justify-content:center;margin-right:5px;font-size:7.5px}.pos{color:#128536}.neg{color:#c70e0e}.footer{position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);display:flex;align-items:center;padding-left:50px;color:#fff;overflow:hidden}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:20px;font-size:22px;font-weight:800}.footer-inner strong{color:#ff7414;font-size:25px}.footer svg{width:34px;height:34px;stroke-width:2}.footer-sep{width:2px;height:40px;background:rgba(255,255,255,.72);margin:0 10px 0 4px}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
function fmt(n){return Number(n||0).toLocaleString('en-US')}
function pct(n,d=0){return `${(Number(n||0)*100).toFixed(d)}%`}
function pp(n){return `${n>=0?'+':''}${(Number(n||0)*100).toFixed(1)} pp`}
function signed(n){return `${n>=0?'+':''}${fmt(n)}`}
function wrapLabel(name,max=10){const words=String(name||'').trim().split(/\s+/);const lines=[];let line='';words.forEach(w=>{if(!line)line=w;else if((line+' '+w).length<=max)line+=' '+w;else{lines.push(line);line=w}});if(line)lines.push(line);return lines}
function totalTime(month){return (month.items||[]).reduce((a,r)=>a+Number(r.tiempo||0),0)}
function chartSvg(month,label){const rows=month.items||[];const maxCant=Math.max(1,...rows.map(r=>Number(r.cantidad||0))),yStep=Math.max(1,Math.ceil(maxCant/5)),yMax=yStep*5,maxPct=Math.max(.30,...rows.map(r=>Number(r.pct||0))),pctMax=Math.ceil(maxPct/.10)*.10,pctFloor=-.08,ml=48,mr=42,mt=30,mb=104,w=720,h=320,pw=w-ml-mr,ph=h-mt-mb,n=rows.length||1,slot=pw/n,bw=Math.min(44,slot*.44),sx=i=>ml+slot*i+slot/2,sy=v=>mt+ph-(Number(v||0)/yMax)*ph,syp=v=>mt+ph-((Number(v||0)-pctFloor)/(pctMax-pctFloor))*ph;%>
<div class="chart-box"><div class="chart-head"><div class="chart-title"><%=label%></div><div class="legend-inline"><span class="leg"><i class="legbox"></i>Cantidad</span><span class="leg"><i class="legline"></i>% participación</span></div></div><svg class="chart-svg" viewBox="0 0 720 320"><text class="axis" x="10" y="23">Incidencias</text><text class="axis" x="650" y="23" text-anchor="end">% Participación</text><% for(let t=0;t<=yMax;t+=yStep){const y=sy(t);%><line class="grid" x1="<%=ml%>" y1="<%=y%>" x2="<%=w-mr%>" y2="<%=y%>"/><text class="axis" x="<%=ml-7%>" y="<%=y+3%>" text-anchor="end"><%=t%></text><%}%><% for(let p=0;p<=pctMax+1e-9;p+=.10){const y=syp(p);%><text class="axis-r" x="<%=w-mr+8%>" y="<%=y+3%>"><%=Math.round(p*100)%>%</text><%}%><% rows.forEach((r,i)=>{const cx=sx(i),y=sy(r.cantidad),hh=mt+ph-y;%><rect x="<%=cx-bw/2%>" y="<%=y%>" width="<%=bw%>" height="<%=hh%>" rx="2" fill="#3f6fc5" stroke="#315aa5" stroke-width="1.5"/><text class="bar-value" x="<%=cx%>" y="<%=y+hh/2+4%>"><%=fmt(r.cantidad)%></text><%})%><polyline points="<%=rows.map((r,i)=>`${sx(i)},${syp(r.pct)}`).join(' ')%>" fill="none" stroke="#f26b12" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><% rows.forEach((r,i)=>{const cx=sx(i),py=syp(r.pct),txt=pct(r.pct,0),tw=Math.max(30,txt.length*6+9);%><circle class="point" cx="<%=cx%>" cy="<%=py%>" r="4"/><rect class="pct-badge" x="<%=cx-tw/2%>" y="<%=py-22%>" width="<%=tw%>" height="16" rx="7"/><text class="pct-label" x="<%=cx%>" y="<%=py-10%>"><%=txt%></text><% const lines=wrapLabel(r.nombre); %><text class="cat" x="<%=cx%>" y="<%=mt+ph+12%>" text-anchor="middle"><% lines.forEach((line,li)=>{%><tspan x="<%=cx%>" dy="<%=li===0?0:8.2%>"><%=line%></tspan><%})%></text><%})%></svg></div><%}
function causeTable(month,label){const rows=month.items||[];%><div class="panel"><div class="panel-title">CAUSA RAÍZ – <%=label%></div><table class="cause-table"><colgroup><col class="causa"><col class="cant"><col class="tiempo"><col class="porcentaje"></colgroup><thead><tr><th>CAUSA RAÍZ</th><th>CANT.</th><th>TIEMPO</th><th>%</th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%=r.nombre%></td><td><%=fmt(r.cantidad)%></td><td><%=r.tiempo==null?'—':fmt(r.tiempo)%></td><td><%=pct(r.pct,0)%></td></tr><%})%></tbody></table></div><%}
const leaderJ=(junio.items&&junio.items[0])||{nombre:'Sin datos',cantidad:0,pct:0};const leaderL=(julio.items&&julio.items[0])||{nombre:'Sin datos',cantidad:0,pct:0};const dTotal=Number(diffTotal||0),dTop=Number(diffTopTen||0),dPct=Number(diffPct||0);const timeJ=totalTime(junio),timeL=totalTime(julio);
%>
<div class="slide">
  <div class="brand"><div class="brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span class="brand-text"><span class="w1">COMM</span><span class="w2">COMMUNICATIONS</span><span class="w3">AND SYSTEMS DEVELOPMENT</span></span></div></div>
  <header class="header"><div class="title"><%= titulo %></div><div class="underline"></div></header>
  <section class="kpis">
    <div class="kpi gray"><div class="kpi-icon">JUN</div><div><div class="kpi-label">Incidentes junio</div><div class="kpi-value"><%=fmt(junio.totalIncidentes)%></div><div class="kpi-sub">Top Ten: <%=fmt(junio.topTen)%> · <%=pct(junio.pctTopTen,1)%></div></div></div>
    <div class="kpi teal"><div class="kpi-icon">JUL</div><div><div class="kpi-label">Incidentes julio</div><div class="kpi-value"><%=fmt(julio.totalIncidentes)%></div><div class="kpi-sub">Top Ten: <%=fmt(julio.topTen)%> · <%=pct(julio.pctTopTen,1)%></div></div></div>
    <div class="kpi blue"><div class="kpi-icon">Δ</div><div><div class="kpi-label">Variación mensual</div><div class="kpi-value"><%=signed(dTotal)%></div><div class="kpi-sub">Top Ten <%=signed(dTop)%></div></div></div>
    <div class="kpi orange"><div class="kpi-icon">%</div><div><div class="kpi-label">Participación julio</div><div class="kpi-value"><%=pct(julio.pctTopTen,1)%></div><div class="kpi-sub"><%=pp(dPct)%> vs junio</div></div></div>
  </section>
  <section class="charts"><%- chartSvg(junio,'JUNIO') %><%- chartSvg(julio,'JULIO') %></section>
  <section class="bottom"><%- causeTable(junio,'JUNIO') %><div class="panel summary"><div class="summary-head">RESUMEN EJECUTIVO</div><div class="summary-body"><p>Incidentes: <b><%=fmt(junio.totalIncidentes)%></b> → <b><%=fmt(julio.totalIncidentes)%></b> (<span class="<%=dTotal>=0?'pos':'neg'%>"><%=signed(dTotal)%></span>).</p><p>Participación Top Ten: <b><%=pct(junio.pctTopTen,1)%></b> → <b><%=pct(julio.pctTopTen,1)%></b> (<%=pp(dPct)%>).</p><p>Principal causa julio: <b><%=leaderL.nombre%></b> con <b><%=fmt(leaderL.cantidad)%></b> (<%=pct(leaderL.pct,0)%>).</p><p>Tiempo registrado: junio <b><%=fmt(timeJ)%></b> · julio <b><%=fmt(timeL)%></b>.</p></div></div><%- causeTable(julio,'JULIO') %></section>
  <footer class="footer"><div class="footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span class="footer-sep"></span><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><div class="footer-orange"></div></footer>
</div>
</body>
</html>
