<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= titulo %></title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:1600px;height:900px;overflow:hidden}body{font-family:Arial,Helvetica,sans-serif;background:#fff;color:#0b2f6c}.slide{position:relative;width:1600px;height:900px;padding:18px 30px 86px;background:linear-gradient(135deg,#fff 0%,#fbfdff 70%,#f4f8fd 100%);overflow:hidden}.brand{position:absolute;right:0;top:0;width:410px;height:86px;border-bottom-left-radius:235px 92px;background:linear-gradient(145deg,#17498f,#0a3b78 60%,#062d61);display:flex;align-items:center;justify-content:flex-end;padding-right:30px;color:#fff;z-index:2}.brand-lock{display:flex;align-items:center;gap:12px}.brand svg,.footer svg{stroke:#fff;fill:none}.brand svg{width:42px;height:42px;stroke-width:2.2}.brand-word{font-size:39px;font-weight:900;letter-spacing:1px}.header{height:70px;position:relative;z-index:3;padding-right:420px}.title{font-size:35px;font-weight:900;line-height:1.05;color:#0b2f6c;white-space:nowrap}.underline{width:92px;height:5px;border-radius:3px;background:#f26b12;margin-top:11px}.cards{height:58px;display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:0}.card{background:#fff;border:1px solid #d8e4ef;border-radius:14px;box-shadow:0 5px 12px rgba(18,71,125,.09);padding:7px 18px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}.card-title{font-size:19px;font-weight:900;color:#0b2f6c;letter-spacing:.4px;margin-bottom:4px}.card-line{font-size:14.2px;font-weight:800;color:#17366f;white-space:nowrap}.card-line strong{font-size:15.5px;color:#f26b12}.charts{height:345px;display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:9px}.chart-box{background:#fff;border:1px solid #d8e4ef;border-radius:14px;box-shadow:0 6px 14px rgba(18,71,125,.08);padding:8px 12px 5px}.chart-head{height:32px;display:flex;align-items:center;justify-content:center;gap:28px}.chart-title{font-size:22px;font-weight:900;color:#0b2f6c;text-transform:uppercase}.legend-inline{display:flex;align-items:center;justify-content:center;gap:20px;font-size:11px;font-weight:800;color:#66768a}.leg{display:flex;gap:7px;align-items:center}.legbox{width:17px;height:8px;background:#9fb8d7;border:1px solid #4d8dd3}.legline{width:28px;height:3px;background:#f26b12;position:relative}.legline:after{content:'';position:absolute;left:11px;top:-3px;width:8px;height:8px;border-radius:50%;background:#f26b12}.chart-svg{width:100%;height:298px;display:block;overflow:visible}.grid{stroke:#dbe3ec;stroke-width:1}.axis{font-size:10px;fill:#223e68;font-weight:800}.axis-r{font-size:10px;fill:#2b2b2b;font-weight:800}.cat{font-size:7.8px;fill:#253e64;font-weight:800}.bar-value{font-size:10.5px;fill:#fff;font-weight:900;text-anchor:middle}.pct-label{font-size:9.5px;fill:#ff5a00;font-weight:900;text-anchor:middle}.pct-badge{fill:#fff;stroke:#ff5a00;stroke-width:1.2}.point{fill:#f26b12;stroke:#fff;stroke-width:1.7}.bottom{height:255px;display:grid;grid-template-columns:1.05fr .82fr 1.05fr;gap:16px;margin-top:11px}.panel{background:#fff;border:1px solid #d8e4ef;border-radius:10px;overflow:hidden;box-shadow:0 5px 12px rgba(18,71,125,.06)}.panel-title{height:27px;background:linear-gradient(90deg,#062f69,#0a4a98);color:#fff;font-size:12.5px;font-weight:900;display:flex;align-items:center;justify-content:center;text-transform:uppercase}.cause-table{width:100%;border-collapse:collapse;font-size:8.25px;color:#0b1630}.cause-table th{font-size:7.6px;color:#0b2f6c;padding:7px 6px 5px;text-align:center;font-weight:900;border-bottom:1px solid #d9e3ef}.cause-table th:first-child{text-align:left}.cause-table td{padding:5.3px 6px;border-bottom:1px solid rgba(93,139,224,.13);font-weight:700;text-align:center}.cause-table td:first-child{text-align:left;font-weight:600;line-height:1.05}.cause-table tr:last-child td{border-bottom:none}.center-stack{display:grid;grid-template-rows:128px 116px;gap:11px}.small-table{width:100%;border-collapse:collapse;color:#0b1630}.small-table th{background:#eef4fb;font-size:8.7px;padding:5px;border:1px solid #c4d2e3}.small-table td{padding:6px 5px;border:1px solid #c4d2e3;text-align:center;font-size:9.8px;font-weight:900}.small-table td:first-child{text-align:left}.pos{color:#128536}.neg{color:#c70e0e}.obs{padding:8px 12px;font-size:10px;line-height:1.22;color:#112a55;font-weight:700}.obs p{margin:0 0 6px}.obs p:before{content:'●';color:#0d4a98;margin-right:6px}.footer{position:absolute;left:25px;right:25px;bottom:16px;height:63px;background:linear-gradient(90deg,#2e56a0,#063774);display:flex;align-items:center;padding-left:32px;color:#fff;overflow:hidden}.footer svg{width:30px;height:30px;stroke-width:2}.footer-inner{position:relative;z-index:2;display:flex;align-items:center;gap:17px;font-size:22px;color:rgba(255,255,255,.68);font-weight:800}.footer-inner strong{color:rgba(255,255,255,.72);font-size:25px}.footer-orange{position:absolute;right:-22px;bottom:-28px;width:180px;height:104px;background:#f8751a;border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<%
function fmt(n){return Number(n||0).toLocaleString('en-US')}
function pct(n,d=0){return `${(Number(n||0)*100).toFixed(d)}%`}
function pp(n){return `${n>=0?'+':''}${(n*100).toFixed(1)} pp`}
function signed(n){return `${n>=0?'+':''}${fmt(n)}`}
function splitLabel(name){const s=String(name||'').trim();const suf=(s.match(/\([^)]*\)$/)||[''])[0];const base=suf?s.replace(/\s*\([^)]*\)$/,''):s;let lines=[];if(/^Cable Roto/i.test(base)){lines=['Cable Roto',base.replace(/^Cable Roto\s*/i,'').trim()]}else{let cur='';base.split(/\s+/).forEach(w=>{if(!cur)cur=w;else if((cur+' '+w).length<=11)cur+=' '+w;else{lines.push(cur);cur=w}});if(cur)lines.push(cur)}if(suf)lines.push(suf);return lines.slice(0,4)}
function hasTime(month){return (month.items||[]).some(r=>r.tiempo!==null&&r.tiempo!==undefined)}
function chartSvg(month,label){const rows=month.items||[];const maxCant=Math.max(1,...rows.map(r=>r.cantidad));const yMax=Math.ceil(maxCant/5)*5||5;const maxPct=Math.max(.30,...rows.map(r=>r.pct));const pctMax=Math.ceil(maxPct/.10)*.10;const pctFloor=-.08;const ml=48,mr=42,mt=15,mb=84,w=720,h=298,pw=w-ml-mr,ph=h-mt-mb,n=rows.length||1,slot=pw/n,bw=Math.min(46,slot*.46);const sx=i=>ml+slot*i+slot/2;const sy=v=>mt+ph-(Number(v||0)/yMax)*ph;const syp=v=>mt+ph-((Number(v||0)-pctFloor)/(pctMax-pctFloor))*ph;%>
<div class="chart-box"><div class="chart-head"><div class="chart-title"><%= label %></div><div class="legend-inline"><span class="leg"><i class="legbox"></i>Cantidad acumulada</span><span class="leg"><i class="legline"></i>% participación</span></div></div><svg class="chart-svg" viewBox="0 0 720 298"><text class="axis" x="0" y="13">Incidencias</text><text class="axis" x="666" y="13">% Participación</text><% for(let t=0;t<=yMax;t+=Math.max(1,Math.ceil(yMax/5))){const y=sy(t);%><line class="grid" x1="<%=ml%>" y1="<%=y%>" x2="<%=w-mr%>" y2="<%=y%>"/><text class="axis" x="<%=ml-7%>" y="<%=y+3%>" text-anchor="end"><%=t%></text><%}%><% for(let p=0;p<=pctMax+1e-9;p+=.10){const y=syp(p);%><text class="axis-r" x="<%=w-mr+8%>" y="<%=y+3%>"><%=Math.round(p*100)%>%</text><%}%><% rows.forEach((r,i)=>{const cx=sx(i),y=sy(r.cantidad),hh=mt+ph-y;%><rect x="<%=cx-bw/2%>" y="<%=y%>" width="<%=bw%>" height="<%=hh%>" rx="2" fill="#9fb8d7" stroke="#4d8dd3" stroke-width="1.8"/><text class="bar-value" x="<%=cx%>" y="<%=y+hh/2+4%>"><%=fmt(r.cantidad)%></text><%})%><polyline points="<%=rows.map((r,i)=>`${sx(i)},${syp(r.pct)}`).join(' ')%>" fill="none" stroke="#f26b12" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><% rows.forEach((r,i)=>{const cx=sx(i),py=syp(r.pct),txt=pct(r.pct,0),tw=Math.max(30,txt.length*6+9);%><circle class="point" cx="<%=cx%>" cy="<%=py%>" r="4"/><rect class="pct-badge" x="<%=cx-tw/2%>" y="<%=py-24%>" width="<%=tw%>" height="18" rx="7"/><text class="pct-label" x="<%=cx%>" y="<%=py-11%>"><%=txt%></text><%})%><% rows.forEach((r,i)=>{const cx=sx(i),lines=splitLabel(r.nombre);%><text class="cat" x="<%=cx%>" y="<%=mt+ph+14%>" text-anchor="middle"><% lines.forEach((line,li)=>{%><tspan x="<%=cx%>" dy="<%=li===0?0:9.2%>"><%=line%></tspan><%})%></text><%})%></svg></div><% }
function causeTable(month,label){ const showTime=hasTime(month); const rows=month.items||[]; %><div class="panel"><div class="panel-title">CAUSA RAÍZ – <%=label%></div><table class="cause-table"><thead><tr><th>CAUSA RAÍZ</th><th>CANT.</th><% if(showTime){ %><th>TIEMPO</th><% } %><th>%</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%=r.nombre%></td><td><%=fmt(r.cantidad)%></td><% if(showTime){ %><td><%=r.tiempo==null?'—':fmt(r.tiempo)%></td><% } %><td><%=pct(r.pct,0)%></td></tr><% }) %></tbody></table></div><% }
%>
<div class="slide">
  <div class="brand"><div class="brand-lock"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><div class="brand-word">COMM</div></div></div>
  <header class="header"><div class="title"><%= titulo %></div><div class="underline"></div></header>
  <section class="cards"><% [['JUNIO',junio],['JULIO',julio]].forEach(([label,m])=>{ %><div class="card"><div class="card-title"><%=label%></div><div class="card-line">Total: <b><%=fmt(m.totalIncidentes)%></b> &nbsp;&nbsp; Top Ten: <b><%=fmt(m.topTen)%></b> &nbsp;&nbsp; Participación: <strong><%=pct(m.pctTopTen,1)%></strong></div></div><% }) %></section>
  <section class="charts"><%- chartSvg(junio,'JUNIO') %><%- chartSvg(julio,'JULIO') %></section>
  <section class="bottom">
    <%- causeTable(junio,'JUNIO') %>
    <div class="center-stack"><div class="panel"><div class="panel-title">Comparativo Junio vs Julio</div><table class="small-table"><tr><th></th><th>Total</th><th>Top Ten</th><th>% Participación</th></tr><tr><td>JUNIO</td><td><%=fmt(junio.totalIncidentes)%></td><td><%=fmt(junio.topTen)%></td><td><%=pct(junio.pctTopTen,1)%></td></tr><tr><td>JULIO</td><td><%=fmt(julio.totalIncidentes)%></td><td><%=fmt(julio.topTen)%></td><td><%=pct(julio.pctTopTen,1)%></td></tr><tr><td>VAR.</td><td class="<%=diffTotal>=0?'pos':'neg'%>"><%=signed(diffTotal)%></td><td class="<%=diffTopTen>=0?'pos':'neg'%>"><%=signed(diffTopTen)%></td><td class="<%=diffPct>=0?'pos':'neg'%>"><%=pp(diffPct)%></td></tr></table></div><div class="panel"><div class="panel-title">Observaciones clave</div><div class="obs"><p>Participación: <b><%=pct(junio.pctTopTen,1)%></b> → <b><%=pct(julio.pctTopTen,1)%></b> (<b><%=pp(diffPct)%></b>).</p><p>Principal causa: <b><%= junio.items[0]?.nombre || 'La principal causa' %></b>.</p><p>Tablas completas sin invadir el pie.</p></div></div></div>
    <%- causeTable(julio,'JULIO') %>
  </section>
  <footer class="footer"><div class="footer-inner"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.<strong>COMMUNICATIONS</strong>.com.pe</span></div><div class="footer-orange"></div></footer>
</div>
</body>
</html>