<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<%
const money = v => Number(v || 0) ? '$ ' + Number(v).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) : '$ -';
const shortMoney = v => Number(v || 0) ? '$' + Number(v).toLocaleString('en-US', {maximumFractionDigits:0}) : '$ -';
const pctText = v => (Number(v || 0) % 1 === 0 ? Number(v || 0).toFixed(0) : Number(v || 0).toFixed(1)) + '%';
const label = s => String(s || '').replace(/\s+/g, ' ');
const rowsSafe = Array.isArray(rows) ? rows : [];
const maxTotal = Math.max(1, ...rowsSafe.map(r => Number(r.total || 0)));
const maxPct = Math.max(1, ...rowsSafe.map(r => Number(r.pct || 0)));
const yMax = Math.ceil(maxTotal / (maxTotal > 10000 ? 5000 : maxTotal > 3000 ? 1000 : 500)) * (maxTotal > 10000 ? 5000 : maxTotal > 3000 ? 1000 : 500);
const pMax = Math.max(10, Math.ceil(maxPct / 5) * 5);
const chart = { x: 70, y: 132, w: 705, h: 360 };
const gap = rowsSafe.length ? chart.w / rowsSafe.length : chart.w;
const barW = Math.min(58, Math.max(32, gap * 0.46));
%>
<style>
  :root{--navy:#17366f;--blue:#2f5fae;--blue2:#133f8d;--orange:#e8752a;--grid:#dfe7f1;--text:#0f1d3a;--muted:#6b778d;--light:#f3f7fc}
  *{box-sizing:border-box} body{margin:0;background:#fff;font-family:Arial,Helvetica,sans-serif;color:var(--text)}
  .slide{position:relative;width:1600px;height:900px;overflow:hidden;background:#fff}
  .title{position:absolute;left:28px;top:28px;font-size:36px;font-weight:900;color:var(--navy);letter-spacing:.2px;max-width:1060px;white-space:nowrap}
  .accent{position:absolute;top:33px;left:1080px;width:92px;height:5px;background:var(--orange);border-radius:12px}
  .brand{position:absolute;right:0;top:0;width:395px;height:86px;background:linear-gradient(145deg,#0d478e,#073772);border-bottom-left-radius:210px 92px;color:#fff;display:flex;align-items:center;justify-content:flex-end;padding-right:44px;gap:16px}
  .brand svg{width:43px;height:43px;stroke:#fff;fill:none;stroke-width:2.2}.brand b{font-size:40px;letter-spacing:.5px}
  .summary{position:absolute;top:105px;height:82px;border:1.5px solid #dbe5ef;border-radius:18px;background:#fff;box-shadow:0 10px 22px rgba(20,45,85,.045)}
  .s1{left:48px;width:470px}.s2{left:565px;width:470px}.s3{left:1082px;width:470px}.icon{position:absolute;left:24px;top:21px;width:52px;height:52px;border-radius:50%;background:linear-gradient(145deg,#174fa8,#2f70c7);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900}.summary .lbl{position:absolute;left:96px;top:20px;font-size:19px;font-weight:900;color:var(--navy)}.summary .val{position:absolute;left:96px;top:48px;font-size:27px;font-weight:900;color:var(--orange)}
  .panel{position:absolute;top:210px;height:590px;border:1.5px solid #dbe5ef;border-radius:18px;background:#fff;box-shadow:0 12px 28px rgba(20,45,85,.055)}.chartPanel{left:48px;width:870px}.tablePanel{left:940px;width:612px;overflow:hidden}
  .panelTitle{position:absolute;left:26px;top:18px;font-size:24px;font-weight:900;color:var(--navy)}.panelSub{position:absolute;left:26px;top:50px;font-size:13px;font-weight:800;color:var(--muted)}.legend{position:absolute;left:305px;top:85px;display:flex;gap:32px;align-items:center;font-size:13px;font-weight:800;color:var(--navy)}.legend .box{width:18px;height:12px;background:linear-gradient(180deg,#2f66bd,#15438f);display:inline-block;margin-right:8px;border-radius:2px}.legend .line{width:30px;height:3px;background:var(--orange);display:inline-block;margin-right:8px;position:relative;top:-3px}.legend .line:after{content:'';position:absolute;right:-3px;top:-4px;width:11px;height:11px;border-radius:50%;background:var(--orange)}
  .axisLabel{font-size:12px;font-weight:900;fill:var(--navy)}.rightAxisLabel{font-size:12px;font-weight:900;fill:var(--orange)}.tick{font-size:12px;font-weight:800;fill:var(--navy)}.rtick{font-size:12px;font-weight:800;fill:#333}.grid{stroke:var(--grid);stroke-width:1;stroke-dasharray:3 5}.bar{fill:url(#barGrad)}.barText{font-size:11px;font-weight:900;fill:var(--navy)}.pctText{font-size:13px;font-weight:900;fill:var(--orange)}.xlab{font-size:9.5px;font-weight:800;fill:var(--navy)}.pline{fill:none;stroke:var(--orange);stroke-width:3}.pmarker{fill:var(--orange);stroke:#fff;stroke-width:3}
  .tableHead{height:40px;background:linear-gradient(90deg,#0d3d82,#17366f);color:#fff;font-size:20px;font-weight:900;text-align:center;line-height:40px}.t{width:100%;border-collapse:collapse;font-size:12px}.t th{height:34px;color:var(--navy);text-align:left;border-bottom:1px solid #dbe5ef}.t th:nth-child(2),.t th:nth-child(3),.t th:nth-child(4),.t th:nth-child(5),.t td:nth-child(2),.t td:nth-child(3),.t td:nth-child(4),.t td:nth-child(5){text-align:center}.t td{height:34px;border-bottom:1px solid #eef3f8;color:var(--text);font-weight:700}.t .name{padding-left:12px;width:315px;font-weight:600}.t .total{font-weight:900}.t .pct{color:var(--orange);font-weight:900}.totals{position:absolute;left:8px;right:8px;bottom:12px}.totrow{height:28px;background:#eef4fb;margin-top:2px;display:grid;grid-template-columns:1fr 140px 50px;align-items:center;padding:0 10px;font-size:15px;font-weight:900;color:var(--navy)}.totrow.total{background:#e6f0ff}.totrow .pct{color:var(--orange);text-align:center}.empty{position:absolute;left:50px;right:50px;top:190px;text-align:center;color:var(--muted);font-size:20px}.empty b{display:block;color:var(--navy);font-size:24px;margin-bottom:12px}.note{position:absolute;left:18px;bottom:12px;font-size:12px;font-style:italic;color:var(--muted);font-weight:700}
  .footer{position:absolute;left:45px;right:45px;bottom:25px;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);display:flex;align-items:center;padding-left:30px;color:#fff;z-index:8}.footer svg{width:34px;height:34px;stroke:#fff;fill:none;stroke-width:2;margin-right:18px}.footer span{font-size:24px;font-weight:800;margin-left:12px}.footer:after{content:'';position:absolute;right:-26px;bottom:-28px;width:180px;height:105px;background:var(--orange);border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<div class="slide">
  <div class="title"><%= title %></div><div class="accent"></div>
  <div class="brand"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><b>COMM</b></div>
  <div class="summary s1"><div class="icon">S/</div><div class="lbl">Total Suministros</div><div class="val"><%= money(totalSuministros) %></div></div>
  <div class="summary s2"><div class="icon">Σ</div><div class="lbl">Total Top Ten</div><div class="val"><%= money(totalTopTen) %></div></div>
  <div class="summary s3"><div class="icon">%</div><div class="lbl">Participación Top Ten</div><div class="val"><%= totalSuministros ? pctText(participacion) : '-' %></div></div>
  <section class="panel chartPanel">
    <div class="panelTitle">Ranking por costo total</div><div class="panelSub">Barras: monto total &nbsp;|&nbsp; Línea naranja: participación</div>
    <div class="legend"><span><i class="box"></i>Monto (USD)</span><span><i class="line"></i>Participación (%)</span></div>
    <% if (rowsSafe.length) { %>
    <svg width="870" height="590" viewBox="0 0 870 590">
      <defs><linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#2f66bd"/><stop offset="100%" stop-color="#143f86"/></linearGradient></defs>
      <text x="28" y="106" class="axisLabel">Monto total (USD)</text><text x="792" y="106" class="rightAxisLabel">Participación (%)</text>
      <% for (let i=0;i<=5;i++){ const gy = chart.y + chart.h - (chart.h*i/5); const val = yMax*i/5; const pval = pMax*i/5; %>
        <line class="grid" x1="<%= chart.x %>" y1="<%= gy %>" x2="<%= chart.x+chart.w %>" y2="<%= gy %>" />
        <text class="tick" x="<%= chart.x-16 %>" y="<%= gy+4 %>" text-anchor="end"><%= shortMoney(val) %></text>
        <text class="rtick" x="<%= chart.x+chart.w+18 %>" y="<%= gy+4 %>"><%= pctText(pval) %></text>
      <% } %>
      <line x1="<%= chart.x %>" y1="<%= chart.y %>" x2="<%= chart.x %>" y2="<%= chart.y+chart.h %>" stroke="#9ba8bd" stroke-width="1"/><line x1="<%= chart.x %>" y1="<%= chart.y+chart.h %>" x2="<%= chart.x+chart.w %>" y2="<%= chart.y+chart.h %>" stroke="#9ba8bd" stroke-width="1"/><line x1="<%= chart.x+chart.w %>" y1="<%= chart.y %>" x2="<%= chart.x+chart.w %>" y2="<%= chart.y+chart.h %>" stroke="#9ba8bd" stroke-width="1"/>
      <% rowsSafe.forEach((r,idx)=>{ const cx=chart.x+gap*idx+gap/2; const bh=Math.max(3,chart.h*(r.total/yMax)); const bx=cx-barW/2; const by=chart.y+chart.h-bh; %>
        <rect class="bar" x="<%= bx %>" y="<%= by %>" width="<%= barW %>" height="<%= bh %>" rx="4"/>
        <text class="barText" x="<%= cx %>" y="<%= Math.max(chart.y+20, by-10) %>" text-anchor="middle"><%= money(r.total).replace('$ ', '$') %></text>
        <text class="xlab" x="<%= cx %>" y="515" text-anchor="middle"><% label(r.nombre).split(' ').slice(0,7).forEach((word,j)=>{ %><tspan x="<%= cx %>" dy="<%= j===0?0:12 %>"><%= word %></tspan><% }) %></text>
      <% }) %>
      <polyline class="pline" points="<%= rowsSafe.map((r,idx)=>{ const cx=chart.x+gap*idx+gap/2; const py=chart.y+chart.h-(chart.h*(r.pct/pMax)); return cx+','+py; }).join(' ') %>" />
      <% rowsSafe.forEach((r,idx)=>{ const cx=chart.x+gap*idx+gap/2; const py=chart.y+chart.h-(chart.h*(r.pct/pMax)); const labelY=Math.max(chart.y+18, py-30); %>
        <circle class="pmarker" cx="<%= cx %>" cy="<%= py %>" r="7"/>
        <text class="pctText" x="<%= cx %>" y="<%= labelY %>" text-anchor="middle"><%= pctText(r.pct) %></text>
      <% }) %>
    </svg>
    <% } else { %>
      <div class="empty"><b>No hay suministros registrados.</b>Sin datos de suministros para julio 2026.</div>
    <% } %>
  </section>
  <section class="panel tablePanel">
    <div class="tableHead">DETALLE TOP TEN - <%= unit %></div>
    <table class="t"><thead><tr><th style="padding-left:12px">Suministro</th><th>Unidad</th><th>Cant.</th><th>Total</th><th>%</th></tr></thead><tbody>
    <% rowsSafe.forEach(r=>{ %><tr><td class="name"><%= label(r.nombre).length > 64 ? label(r.nombre).slice(0,64)+'…' : label(r.nombre) %></td><td><%= r.unidad %></td><td><%= Number(r.cantidad || 0).toLocaleString('en-US') %></td><td class="total"><%= money(r.total) %></td><td class="pct"><%= pctText(r.pct) %></td></tr><% }) %>
    </tbody></table>
    <% if (!rowsSafe.length) { %><div class="empty"><b>No hay registros de suministros.</b></div><% } %>
    <div class="totals"><div class="totrow"><span>Total Top Ten</span><span><%= money(totalTopTen) %></span><span class="pct"><%= totalSuministros ? pctText(participacion) : '-' %></span></div><div class="totrow total"><span>Total Suministros</span><span><%= money(totalSuministros) %></span><span></span></div></div>
  </section>
  <footer class="footer"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.COMMUNICATIONS.com.pe</span></footer>
</div>
</body>
</html>
