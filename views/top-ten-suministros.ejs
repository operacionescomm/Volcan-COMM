<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<%
const money = v => Number(v || 0) ? '$ ' + Number(v).toLocaleString('en-US', { minimumFractionDigits:2, maximumFractionDigits:2 }) : '$ -';
const pctText = v => (Number(v || 0) % 1 === 0 ? Number(v || 0).toFixed(0) : Number(v || 0).toFixed(1)) + '%';
const clean = s => String(s || '').replace(/\s+/g, ' ').trim();
const rowsSafe = Array.isArray(rows) ? rows : [];
const topTotal = Number(totalTopTen || 0);
const totalSupply = Number(totalSuministros || 0);
const part = Number(participacion || 0);
const maxTotalRaw = Math.max(1, ...rowsSafe.map(r => Number(r.total || 0)));
function fullName(value) {
  let s = clean(value);
  const key = s.toLowerCase();
  if (key.includes('cable tx6a') && key.includes('10gig') && key.includes('shielded copper cable') && !key.includes('pfz6x04wh-ceg')) {
    s = s.replace(/f\/utp/i, 'f/utp (PFZ6X04WH-CEG)');
    if (!s.toLowerCase().includes('pfz6x04wh-ceg')) s += ' (PFZ6X04WH-CEG)';
  }
  return s;
}
%>
<style>
:root{--navy:#17366f;--blue:#2f5fae;--blue2:#143f86;--orange:#e8752a;--grid:#dfe7f1;--text:#0f1d3a;--muted:#6b778d;--light:#f3f7fc}
*{box-sizing:border-box} body{margin:0;background:#fff;font-family:Arial,Helvetica,sans-serif;color:var(--text)}
.slide{position:relative;width:1600px;height:900px;overflow:hidden;background:#fff}
.title{position:absolute;left:28px;top:28px;font-size:36px;font-weight:900;color:var(--navy);letter-spacing:.2px;max-width:1085px;white-space:nowrap}
.accent{position:absolute;top:33px;left:1080px;width:92px;height:5px;background:var(--orange);border-radius:12px}
.brand{position:absolute;right:0;top:0;width:395px;height:86px;background:linear-gradient(145deg,#0d478e,#073772);border-bottom-left-radius:210px 92px;color:#fff;display:flex;align-items:center;justify-content:flex-end;padding-right:44px;gap:16px}.brand svg{width:43px;height:43px;stroke:#fff;fill:none;stroke-width:2.2}.brand b{font-size:40px;letter-spacing:.5px}
.summary{position:absolute;top:105px;height:82px;border:1.5px solid #dbe5ef;border-radius:18px;background:#fff;box-shadow:0 10px 22px rgba(20,45,85,.045)}.s1{left:48px;width:470px}.s2{left:565px;width:470px}.s3{left:1082px;width:470px}.icon{position:absolute;left:24px;top:21px;width:52px;height:52px;border-radius:50%;background:linear-gradient(145deg,#174fa8,#2f70c7);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900}.summary .lbl{position:absolute;left:96px;top:20px;font-size:19px;font-weight:900;color:var(--navy)}.summary .val{position:absolute;left:96px;top:48px;font-size:27px;font-weight:900;color:var(--orange)}
.panel{position:absolute;top:210px;height:590px;border:1.5px solid #dbe5ef;border-radius:18px;background:#fff;box-shadow:0 12px 28px rgba(20,45,85,.055)}.chartPanel{left:48px;width:870px}.tablePanel{left:940px;width:612px;overflow:hidden}.panelTitle{position:absolute;left:26px;top:18px;font-size:24px;font-weight:900;color:var(--navy)}.panelSub{position:absolute;left:26px;top:50px;font-size:13px;font-weight:800;color:var(--muted)}
.tableHead{height:40px;background:linear-gradient(90deg,#0d3d82,#17366f);color:#fff;font-size:20px;font-weight:900;text-align:center;line-height:40px}.t{width:100%;border-collapse:collapse;font-size:10.2px}.t th{height:30px;color:var(--navy);text-align:left;border-bottom:1px solid #dbe5ef}.t th:nth-child(n+2),.t td:nth-child(n+2){text-align:center}.t td{height:40px;border-bottom:1px solid #eef3f8;color:var(--text);font-weight:700;vertical-align:middle;line-height:1.08}.t .name{padding-left:12px;width:350px;font-weight:600;white-space:normal;overflow:visible}.t .total{font-weight:900;white-space:nowrap}.t .pct{color:var(--orange);font-weight:900;white-space:nowrap}.totals{position:absolute;left:8px;right:8px;bottom:12px}.totrow{height:28px;background:#eef4fb;margin-top:2px;display:grid;grid-template-columns:1fr 140px 50px;align-items:center;padding:0 10px;font-size:15px;font-weight:900;color:var(--navy)}.totrow.total{background:#e6f0ff}.totrow .pct{color:var(--orange);text-align:center}.empty{position:absolute;left:50px;right:50px;top:190px;text-align:center;color:var(--muted);font-size:20px}.empty b{display:block;color:var(--navy);font-size:24px;margin-bottom:12px}
.hlist{position:absolute;left:24px;right:22px;top:86px;bottom:34px}.hrow{position:relative;height:43px;margin-bottom:4px}.hname{position:absolute;left:0;top:0;width:250px;font-size:9.3px;font-weight:900;line-height:1.08;color:var(--navy);white-space:normal;overflow:visible}.htrack{position:absolute;left:270px;right:76px;top:8px;height:24px;background:#f1f4f8;border-radius:6px;overflow:visible}.hbar{position:absolute;left:0;top:0;height:24px;min-width:96px;border-radius:6px;background:linear-gradient(90deg,#3569bf,#143f86);box-shadow:0 4px 10px rgba(20,50,100,.12);overflow:visible}.hmoney{position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:13px;font-weight:900;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.35);white-space:nowrap}.hpct{position:absolute;right:0;top:5px;min-width:48px;height:27px;line-height:23px;border:2px solid var(--orange);border-radius:9px;background:#fff;color:var(--orange);font-size:14px;font-weight:900;text-align:center;padding:1px 7px;white-space:nowrap}.footer{position:absolute;left:45px;right:45px;bottom:25px;height:66px;background:linear-gradient(90deg,#0d4a98,#063774);display:flex;align-items:center;padding-left:30px;color:#fff;z-index:8}.footer svg{width:34px;height:34px;stroke:#fff;fill:none;stroke-width:2;margin-right:18px}.footer span{font-size:24px;font-weight:800;margin-left:12px}.footer:after{content:'';position:absolute;right:-26px;bottom:-28px;width:180px;height:105px;background:var(--orange);border-radius:70% 0 0 0;transform:rotate(-7deg)}
</style>
</head>
<body>
<div class="slide">
  <div class="title"><%= title %></div><div class="accent"></div>
  <div class="brand"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8 11.1-8.8 18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><b>COMM</b></div>
  <div class="summary s1"><div class="icon">S/</div><div class="lbl">Total Suministros</div><div class="val"><%= money(totalSupply) %></div></div>
  <div class="summary s2"><div class="icon">Σ</div><div class="lbl">Total Top Ten</div><div class="val"><%= money(topTotal) %></div></div>
  <div class="summary s3"><div class="icon">%</div><div class="lbl">Participación Top Ten</div><div class="val"><%= totalSupply ? pctText(part) : '-' %></div></div>
  <section class="panel chartPanel">
    <div class="panelTitle">Ranking por costo total</div><div class="panelSub">Barras: monto total &nbsp;|&nbsp; Etiqueta naranja: participación</div>
    <% if (rowsSafe.length) { %>
      <div class="hlist">
        <% rowsSafe.forEach(r => { const w = Math.max(2, (Number(r.total || 0) / maxTotalRaw) * 100); %>
          <div class="hrow">
            <div class="hname"><%= fullName(r.nombre) %></div>
            <div class="htrack"><div class="hbar" style="width:<%= w %>%"><span class="hmoney"><%= money(r.total).replace('$ ', '$') %></span></div></div>
            <div class="hpct"><%= pctText(r.pct) %></div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty"><b>Sin suministros registrados</b>No se reportan costos de suministros para julio 2026.</div>
    <% } %>
  </section>
  <section class="panel tablePanel">
    <div class="tableHead">DETALLE TOP TEN - <%= unit %></div>
    <table class="t"><thead><tr><th style="padding-left:12px">Suministro</th><th>Unidad</th><th>Cant.</th><th>Total</th><th>%</th></tr></thead><tbody>
    <% rowsSafe.forEach(r=>{ %><tr><td class="name"><%= fullName(r.nombre) %></td><td><%= r.unidad %></td><td><%= Number(r.cantidad || 0).toLocaleString('en-US') %></td><td class="total"><%= money(r.total) %></td><td class="pct"><%= pctText(r.pct) %></td></tr><% }) %>
    </tbody></table>
    <% if (!rowsSafe.length) { %><div class="empty"><b>No hay registros de suministros.</b></div><% } %>
    <div class="totals"><div class="totrow"><span>Total Top Ten</span><span><%= money(topTotal) %></span><span class="pct"><%= totalSupply ? pctText(part) : '-' %></span></div><div class="totrow total"><span>Total Suministros</span><span><%= money(totalSupply) %></span><span></span></div></div>
  </section>
  <footer class="footer"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M24 6c5.8 5 8.8 11.1 8.8 18S29.8 37 24 42M24 6c-5.8 5-8.8-11.1-8.8-18S18.2 37 24 42M10 15c8.8 4 19.2 4 28 0M10 33c8.8-4 19.2-4 28 0"/></svg><span>www.COMMUNICATIONS.com.pe</span></footer>
</div>
</body>
</html>