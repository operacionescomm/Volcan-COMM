<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Cantidad de Atenciones - U.M. <%= unidadNombre %></title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:1600px;height:900px;overflow:hidden}body{font-family:Arial,Helvetica,sans-serif;background:linear-gradient(135deg,#fff 0%,#f7fbff 72%,#eef5ff 100%);color:#0b2d67}.slide{position:relative;width:1600px;height:900px;padding:20px 28px 16px;overflow:hidden}.brand{position:absolute;right:0;top:0;width:360px;height:105px;border-bottom-left-radius:215px 100px;background:linear-gradient(145deg,#0e4b98,#073a79 55%,#062d62);box-shadow:inset 16px 0 0 rgba(67,145,226,.24);display:flex;justify-content:flex-end;align-items:center;padding-right:38px;color:#fff;z-index:1}.brand-word{font-size:38px;font-weight:800;letter-spacing:2px}.header{height:108px;padding-left:10px;padding-right:390px;position:relative;z-index:2}.title{font-size:44px;line-height:1.05;font-weight:800;color:#08195a;letter-spacing:.2px;white-space:nowrap;max-width:1150px;overflow:hidden;text-overflow:ellipsis}.subtitle{margin-top:12px;display:flex;align-items:center;gap:10px;font-size:20px;color:#132d69;white-space:nowrap}.subtitle strong{color:#0d5ec7}.calendar{width:24px;height:24px;border:3px solid #145fd3;border-radius:5px;position:relative;flex:0 0 auto}.calendar:before{content:'';position:absolute;left:2px;right:2px;top:6px;height:3px;background:#145fd3}.calendar:after{content:'';position:absolute;left:5px;right:5px;top:-6px;height:8px;border-left:3px solid #145fd3;border-right:3px solid #145fd3}.kpis{height:160px;display:grid;grid-template-columns:1fr 1.02fr 1.02fr 1.02fr 1.02fr;gap:18px;align-items:stretch}.kpi{height:150px;background:#fff;border:1px solid #d7e4f1;border-radius:19px;box-shadow:0 8px 18px rgba(17,65,120,.11);display:grid;grid-template-columns:76px minmax(0,1fr);align-items:center;padding:12px 14px;min-width:0;overflow:hidden}.kicon{width:70px;height:70px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 7px 15px rgba(15,54,112,.18);background:linear-gradient(145deg,var(--c1),var(--c2));border:1px solid rgba(255,255,255,.45)}.kicon svg{width:41px;height:41px;fill:none;stroke:#fff;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}.kcontent{padding-left:8px;min-width:0}.kname{font-size:15.5px;line-height:1.08;font-weight:800;color:var(--tc);text-transform:uppercase}.kvalue{font-size:42px;line-height:1;font-weight:800;color:var(--tc);margin-top:7px;white-space:nowrap}.ksub{font-size:13px;color:#222;margin-top:4px;white-space:nowrap}.charts{height:398px;display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:10px}.panel{background:#fff;border:1px solid #d9e6f2;border-radius:20px;box-shadow:0 9px 18px rgba(19,70,126,.1);padding:15px 18px 12px;overflow:hidden}.ptitle{height:48px;display:flex;align-items:center;gap:12px;font-size:19px;font-weight:800;color:#0b2d69}.picon{width:43px;height:43px;border-radius:50%;background:linear-gradient(145deg,#288de5,#154fb3);display:flex;align-items:center;justify-content:center;box-shadow:0 5px 10px rgba(31,83,165,.22);flex:0 0 auto}.picon svg{width:25px;height:25px;stroke:#fff;fill:none;stroke-width:2.2}.chart-svg{width:100%;height:296px;display:block;overflow:visible}.grid{stroke:#cfdbea;stroke-width:1;stroke-dasharray:4 4}.axis{font-size:12px;fill:#17346d;font-weight:600}.value{font-size:12px;fill:#111;font-weight:700;text-anchor:middle;paint-order:stroke;stroke:#fff;stroke-width:4;stroke-linejoin:round}.legend{display:flex;justify-content:center;gap:22px;font-size:13px;font-weight:700;color:#17346d;margin-top:-2px}.leg{display:flex;align-items:center;gap:7px}.line{width:27px;height:4px;background:#8e8e8e;border-radius:3px}.box{width:13px;height:13px;background:var(--l)}.summary{height:102px;margin-top:16px;background:#fff;border:1px solid #d6e4f2;border-radius:18px;box-shadow:0 7px 16px rgba(18,69,124,.09);display:grid;grid-template-columns:285px 1fr;align-items:center;padding:10px 24px}.sum-title{height:72px;display:flex;align-items:center;gap:18px;border-right:2px solid #6ea0df;padding-right:24px}.sum-icon{width:68px;height:68px;border-radius:50%;background:linear-gradient(145deg,#278be1,#1551b0);display:flex;align-items:center;justify-content:center}.sum-icon svg{width:37px;height:37px;stroke:#fff;fill:none;stroke-width:2.1}.sum-label{font-size:21px;font-weight:800;color:#0b2d69;line-height:1.1}.sum-lines{padding-left:34px;display:grid;gap:8px;font-size:17px;color:#173b77}.sum-line{display:flex;align-items:center;gap:12px}.check{width:22px;height:22px;border-radius:50%;background:#1556b6;color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;flex:0 0 auto}.footer{position:absolute;left:14px;right:14px;bottom:9px;height:62px;border-radius:16px;background:linear-gradient(90deg,#104ea9,#073b7d)}
</style>
</head>
<body>
<div class="slide">
  <div class="brand"><div class="brand-word">COMM</div></div>
  <div class="header">
    <div class="title"><%= titulo %></div>
    <div class="subtitle"><span class="calendar"></span><span>Datos al mes más reciente: <strong><%= periodo %></strong></span></div>
  </div>
  <section class="kpis">
    <div class="kpi" style="--c1:#9b9b9b;--c2:#5f5f5f;--tc:#4c4c4c"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M7 37 18 15l7 11 8-17 9 28H7Z"/></svg></div><div class="kcontent"><div class="kname">ATENCIONES<br>TOTALES</div><div class="kvalue"><%= totalMes.toLocaleString('en-US') %></div></div></div>
    <div class="kpi" style="--c1:#1aa9b6;--c2:#0c7c88;--tc:#117b83"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M8 37V29h6v8M19 37V22h6v15M30 37V15h6v22"/><path d="m8 23 9-8 7 4 12-12"/></svg></div><div class="kcontent"><div class="kname">ATENCIONES<br>ACUMULADAS</div><div class="kvalue"><%= acumulado12.toLocaleString('en-US') %></div><div class="ksub">últimos 12 meses</div></div></div>
    <div class="kpi" style="--c1:#2d76dc;--c2:#0f4dbf;--tc:#1757c4"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M8 32h32M12 32v-7c0-7 5-13 12-14 7 1 12 7 12 14v7M18 12v10m12-10v10M7 36h34"/></svg></div><div class="kcontent"><div class="kname">INTERIOR MINA (IM)</div><div class="kvalue"><%= im.toLocaleString('en-US') %></div></div></div>
    <div class="kpi" style="--c1:#ff7a24;--c2:#f0530d;--tc:#f05b15"><div class="kicon"><svg viewBox="0 0 48 48"><path d="M7 37 18 15l7 11 8-17 9 28H7Z"/></svg></div><div class="kcontent"><div class="kname">SUPERFICIE (SUP)</div><div class="kvalue"><%= sup.toLocaleString('en-US') %></div></div></div>
    <div class="kpi" style="--c1:#6a56b6;--c2:#49338f;--tc:#44338d"><div class="kicon"><svg viewBox="0 0 48 48"><circle cx="18" cy="17" r="6"/><circle cx="31" cy="17" r="6"/><path d="M7 37c0-7 5-11 11-11s11 4 11 11M23 37c0-7 4-11 9-11 6 0 10 4 10 11"/></svg></div><div class="kcontent"><div class="kname">PROMEDIO<br>ATENCIONES POR DÍA</div><div class="kvalue"><%= promedioDia.toFixed(1) %></div><div class="ksub">atenciones/día</div></div></div>
  </section>
  <section class="charts">
    <div class="panel">
      <div class="ptitle"><span class="picon"><svg viewBox="0 0 32 32"><polyline points="4,24 10,17 15,20 22,10 28,14"/><path d="M4 5v22h24"/></svg></span><%= unidadNombre.toUpperCase() %> – TENDENCIA DE ATENCIONES TOTALES</div>
      <% const w=740,h=286,ml=58,mr=25,mt=18,mb=50,pw=w-ml-mr,ph=h-mt-mb; const ymax=Math.max(100,Math.ceil(maxTotal/100)*100); const sx=i=>ml+(seriesTotal.length<=1?pw/2:i*pw/(seriesTotal.length-1)); const sy=v=>mt+ph-(Number(v||0)/ymax)*ph; const pts=seriesTotal.map((d,i)=>`${sx(i)},${sy(d.total)}`).join(' '); %>
      <svg class="chart-svg" viewBox="0 0 740 286">
        <% for(let t=0;t<=ymax;t+=100){const y=sy(t);%><line class="grid" x1="<%=ml%>" y1="<%=y%>" x2="<%=w-mr%>" y2="<%=y%>"/><text class="axis" x="<%=ml-12%>" y="<%=y+4%>" text-anchor="end"><%=t%></text><%}%>
        <polyline points="<%=pts%>" fill="none" stroke="#8b8b8b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <% seriesTotal.forEach((d,i)=>{ %><circle cx="<%=sx(i)%>" cy="<%=sy(d.total)%>" r="5" fill="#8b8b8b" stroke="#666"/><text class="value" x="<%=sx(i)%>" y="<%=Math.max(mt+11,sy(d.total)-10)%>"><%=d.total%></text><text class="axis" x="<%=sx(i)%>" y="<%=h-17%>" text-anchor="middle"><%=d.mes%></text><% }) %>
        <text class="axis" x="15" y="145" transform="rotate(-90 15 145)" text-anchor="middle" style="font-size:14px;font-weight:800">ATENCIONES</text>
      </svg><div class="legend"><div class="leg"><span class="line"></span>Total</div></div>
    </div>
    <div class="panel">
      <div class="ptitle"><span class="picon"><svg viewBox="0 0 32 32"><path d="M5 26V15h5v11M14 26V8h5v18M23 26V12h5v14"/></svg></span><%= unidadNombre.toUpperCase() %> – ATENCIONES IM vs SUP</div>
      <% const bw=740,bh=286,bl=58,br=24,bt=18,bb=50,bpw=bw-bl-br,bph=bh-bt-bb; const bymax=Math.max(100,Math.ceil(maxImSup/100)*100); const by=v=>bt+bph-(Number(v||0)/bymax)*bph; const gw=bpw/Math.max(1,seriesImSup.length),barW=Math.min(20,gw*.30); %>
      <svg class="chart-svg" viewBox="0 0 740 286">
        <% for(let t=0;t<=bymax;t+=100){const y=by(t);%><line class="grid" x1="<%=bl%>" y1="<%=y%>" x2="<%=bw-br%>" y2="<%=y%>"/><text class="axis" x="<%=bl-12%>" y="<%=y+4%>" text-anchor="end"><%=t%></text><%}%>
        <% seriesImSup.forEach((d,i)=>{const cx=bl+gw*i+gw/2,x1=cx-barW-2,x2=cx+2;%><rect x="<%=x1%>" y="<%=by(d.im)%>" width="<%=barW%>" height="<%=bt+bph-by(d.im)%>" fill="#1764c8"/><rect x="<%=x2%>" y="<%=by(d.sup)%>" width="<%=barW%>" height="<%=bt+bph-by(d.sup)%>" fill="#f36b1b"/><text class="value" x="<%=x1+barW/2%>" y="<%=Math.max(bt+11,by(d.im)-8)%>"><%=d.im%></text><text class="value" x="<%=x2+barW/2%>" y="<%=Math.max(bt+11,by(d.sup)-8)%>"><%=d.sup%></text><text class="axis" x="<%=cx%>" y="<%=bh-17%>" text-anchor="middle"><%=d.mes%></text><%})%>
        <text class="axis" x="15" y="145" transform="rotate(-90 15 145)" text-anchor="middle" style="font-size:14px;font-weight:800">ATENCIONES</text>
      </svg><div class="legend"><div class="leg"><span class="box" style="--l:#1764c8"></span>IM</div><div class="leg"><span class="box" style="--l:#f36b1b"></span>SUP</div></div>
    </div>
  </section>
  <section class="summary"><div class="sum-title"><div class="sum-icon"><svg viewBox="0 0 48 48"><path d="M14 8h20v34H14z"/><path d="M19 5h10v6H19zM19 17h10M19 23h10M19 29h10"/><circle cx="33" cy="35" r="7"/><path d="m30 35 2 2 4-5"/></svg></div><div class="sum-label">RESUMEN<br>EJECUTIVO</div></div><div class="sum-lines"><div class="sum-line"><span class="check">✓</span><span><%= resumen1 %></span></div><div class="sum-line"><span class="check">✓</span><span><%= resumen2 %></span></div></div></section>
  <div class="footer"></div>
</div>
</body>
</html>